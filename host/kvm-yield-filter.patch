+/*
+ * Current count of a perf event that is active on this CPU, as
+ * perf_event_read_local() reads it. That function is not exported to
+ * modules; an event that is not active here is simply not filtered.
+ */
+static bool seedbox_yield_count(struct perf_event *event, u64 *count)
+{
+	unsigned long flags;
+	bool active;
+
+	local_irq_save(flags);
+	active = event->state == PERF_EVENT_STATE_ACTIVE &&
+		 event->oncpu == smp_processor_id();
+	if (active) {
+		event->pmu->read(event);
+		*count = local64_read(&event->count);
+	}
+	local_irq_restore(flags);
+	return active;
+}
+
+/*
+ * Seedbox yield filter: consume the guest's yield write when the count has
+ * not reached userspace's target. Userspace would only resume the guest, so
+ * the guest-visible effect is identical. Any failure exits to userspace.
+ */
+static bool seedbox_yield_consume(struct kvm_vcpu *vcpu, int size,
+				  unsigned short port)
+{
+	struct kvm_seedbox_yield_shared __user *shared = vcpu->arch.seedbox_yield.shared;
+	u64 target, count, consumed;
+
+	if (!shared || port != vcpu->arch.seedbox_yield.port || size != 4)
+		return false;
+	if (get_user(target, &shared->target) || !target)
+		return false;
+	if (!seedbox_yield_count(vcpu->arch.seedbox_yield.perf_file->private_data, &count) ||
+	    count >= target)
+		return false;
+	if (get_user(consumed, &shared->consumed) ||
+	    put_user(consumed + 1, &shared->consumed))
+		return false;
+	return true;
+}
+
+static void seedbox_yield_release(struct kvm_vcpu *vcpu)
+{
+	if (vcpu->arch.seedbox_yield.perf_file)
+		fput(vcpu->arch.seedbox_yield.perf_file);
+	vcpu->arch.seedbox_yield.perf_file = NULL;
+	vcpu->arch.seedbox_yield.shared = NULL;
+}
+
+static int seedbox_yield_set(struct kvm_vcpu *vcpu,
+			     struct kvm_seedbox_yield_filter *f)
+{
+	struct perf_event *event;
+	struct file *file;
+
+	if (f->pad)
+		return -EINVAL;
+	if (f->perf_fd < 0) {
+		seedbox_yield_release(vcpu);
+		return 0;
+	}
+	file = fget(f->perf_fd);
+	if (!file)
+		return -EBADF;
+	/* perf event files are anonymous inodes named "[perf_event]". */
+	if (strcmp(file->f_path.dentry->d_name.name, "[perf_event]")) {
+		fput(file);
+		return -EINVAL;
+	}
+	event = file->private_data;
+	if (!event->attr.exclude_host || event->attr.inherit) {
+		fput(file);
+		return -EINVAL;
+	}
+	seedbox_yield_release(vcpu);
+	vcpu->arch.seedbox_yield.perf_file = file;
+	vcpu->arch.seedbox_yield.shared = u64_to_user_ptr(f->shared);
+	vcpu->arch.seedbox_yield.port = f->port;
+	return 0;
+}
