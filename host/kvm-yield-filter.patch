diff --git a/include/uapi/linux/kvm.h b/include/uapi/linux/kvm.h
index 954e0511c..1c6d0e18e 100644
--- a/include/uapi/linux/kvm.h
+++ b/include/uapi/linux/kvm.h
@@ -1617,6 +1617,26 @@ struct kvm_create_guest_memfd {
 	__u64 reserved[6];
 };
 
+/*
+ * Seedbox yield filter (out of tree). A guest write of 4 bytes to `port` is
+ * consumed in the kernel, without an exit to userspace, while the count of
+ * the perf event `perf_fd` (a counter of the calling thread) is below
+ * `shared->target`. A target of 0, or a perf_fd of -1, disables it.
+ */
+struct kvm_seedbox_yield_filter {
+	__s32 perf_fd;
+	__u16 port;
+	__u16 pad;
+	__u64 shared;	/* user address of struct kvm_seedbox_yield_shared */
+};
+
+struct kvm_seedbox_yield_shared {
+	__u64 target;	/* written by userspace before KVM_RUN */
+	__u64 consumed;	/* incremented by KVM for each consumed write */
+};
+
+#define KVM_SEEDBOX_YIELD_FILTER _IOW(KVMIO, 0xf0, struct kvm_seedbox_yield_filter)
+
 #define KVM_PRE_FAULT_MEMORY	_IOWR(KVMIO, 0xd5, struct kvm_pre_fault_memory)
 
