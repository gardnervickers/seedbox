# Proposed next profile; not the already measured kernel config.
# olddefconfig must resolve these exact values, and the build must fail otherwise.
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=n
CONFIG_HZ_100=y
CONFIG_HZ_250=n
CONFIG_HZ_300=n
CONFIG_HZ_1000=n
CONFIG_HZ=100
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_NONE=y
CONFIG_SMP=n
