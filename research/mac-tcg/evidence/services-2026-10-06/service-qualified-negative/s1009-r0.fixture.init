#!/bin/busybox sh
/bin/busybox --install -s
export PATH=/bin:/usr/bin:/sbin:/usr/sbin
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /data
set -eu
trap 'code=$?; echo "INIT exit=$code"; sbx exit "$code"' EXIT
arg() { sed -n "s/.*seedbox\.$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
. /bin/network.sh
insmod /modules/veth.ko
insmod /modules/act_gact.ko
insmod /modules/sch_ingress.ko
insmod /modules/sch_netem.ko
insmod /modules/cls_u32.ko
insmod /modules/cls_matchall.ko
setup_network
delay=$(arg net_delay); delay=${delay:-1ms}
if [ "$(arg mode)" = controls ]; then network_controls; exit 0; fi
set_delay "$delay"
export GOMAXPROCS=4
peers="n1=http://10.0.1.1:2380,n2=http://10.0.2.1:2380,n3=http://10.0.3.1:2380"
mkdir -p /run
mkfifo /run/seedbox-control
(
 trap 'echo control-helper-exited > /tmp/control.failed' EXIT
 . /bin/members.sh
 for member in n1 n2 n3; do start_member "$member"; done
 touch /tmp/control.launched
 :
 while read -r action member destination < /run/seedbox-control; do
  case "$member" in n1|n2|n3|n4) ;; *) echo "invalid member" >&2; exit 3 ;; esac
  if [ -n "$destination" ]; then
   case "$destination" in n1|n2|n3|n4) ;; *) exit 3 ;; esac
   case "$action" in
    partition) pair_partition "${member#n}" "${destination#n}" ;;
    heal) pair_heal "${member#n}" "${destination#n}" ;;
    *) exit 3 ;;
   esac
   fault_ack "$action $member $destination"; continue
  fi
  case "$action" in
   log) (echo "DIAG $member"; df -h /data /tmp; head -10 /proc/meminfo; tail -20 "/tmp/$member.log"; ps; dmesg | tail -10) > /dev/ttyS1 ;;
   net) tc -s qdisc show > /dev/ttyS1 ;;
   partition) partition "${member#n}"; fault_ack "partition $member" ;;
   heal) heal "${member#n}"; fault_ack "heal $member" ;;
   stop) [ "$member" != n4 ] || exit 3; stop_member "$member"; fault_ack "stop $member stopped" ;;
   start) [ "$member" != n4 ] || exit 3; start_member "$member"; fault_ack "start $member launched" ;;
   *) exit 3 ;;
  esac
 done
) &
helper=$!
while [ ! -f /tmp/control.launched ]; do
 kill -0 "$helper" || exit 3
 [ ! -f /tmp/control.failed ] || exit 3
 sleep .001
done
start_delay=$(arg delay); start_delay=${start_delay:-1.5}
load=$(arg load); load=${load:-10s}
concurrency=$(arg concurrency); concurrency=${concurrency:-8}
writes=$(arg writes); writes=${writes:-0}
sleep "$start_delay"
echo "SEEDBOX_PHASE client_start guest_ns=$(sbx time)"
status=0
ip netns exec n4 /bin/client --endpoints 10.0.1.1:2379,10.0.2.1:2379,10.0.3.1:2379 --duration "$load" --concurrency "$concurrency" --writes "$writes" --plant "$(arg plant)" || status=$?
[ ! -f /tmp/control.failed ] || exit 3
exit "$status"
