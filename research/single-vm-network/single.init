#!/bin/busybox sh
/bin/busybox --install -s
export PATH=/bin:/usr/bin:/sbin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /data
set -eu
trap 'code=$?; echo "INIT exit=$code"; sbx exit "$code"' EXIT
arg() { sed -n "s/.*seedbox\.$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
. /bin/network.sh
setup_network
if [ "$(arg mode)" = controls ]; then network_controls; exit 0; fi
set_delay 1ms
export GOMAXPROCS=4
peers="n1=http://10.0.1.1:2380,n2=http://10.0.2.1:2380,n3=http://10.0.3.1:2380"
start_etcd() {
 member="$1"; i="${member#n}"
 ip netns exec "$member" /bin/etcd --name "$member" --data-dir "/data/$member" \
  --listen-client-urls "http://10.0.$i.1:2379" --advertise-client-urls "http://10.0.$i.1:2379" \
  --listen-peer-urls "http://10.0.$i.1:2380" --initial-advertise-peer-urls "http://10.0.$i.1:2380" \
  --initial-cluster "$peers" --initial-cluster-state new --logger zap --log-level error > "/tmp/$member.log" 2>&1 &
 echo $! > "/tmp/$member.pid"
}
for member in n1 n2 n3; do start_etcd "$member"; done
(stty -F /dev/ttyS1 raw -echo 2>/dev/null
 while read -r action member < /dev/ttyS1; do
  case "$member" in n1|n2|n3) ;; *) continue ;; esac
  case "$action" in
   log) (echo "DIAG $member"; df -h /data /tmp; head -10 /proc/meminfo; head -10 "/tmp/$member.log"; tail -20 "/tmp/$member.log"; ps; dmesg | tail -10) > /dev/ttyS1 ;;
   net) tc -s qdisc show > /dev/ttyS1 ;;
   partition) partition "${member#n}"; echo "$member partitioned" > /dev/ttyS1 ;;
   heal) heal "${member#n}"; echo "$member healed" > /dev/ttyS1 ;;
   stop) kill -9 "$(cat /tmp/$member.pid)"; echo "$member stopped" > /dev/ttyS1 ;;
   start) start_etcd "$member"; echo "$member started" > /dev/ttyS1 ;;
  esac
 done) &
sleep "$(arg delay)"
echo "SEEDBOX_PHASE client_start uptime=$(cat /proc/uptime)"
ip netns exec n4 /bin/client --endpoints 10.0.1.1:2379,10.0.2.1:2379,10.0.3.1:2379 --duration "$(arg load)" --concurrency 2 --writes "$(arg writes)" --plant "$(arg plant)"
