#!/bin/busybox sh
# Windowed-scheduler fixture (docs/windowed-scheduler.md): guest i hashes
# window.work blocks of 64 KiB from /dev/zero while pinging guest (i+1) mod
# window.n, then prints both results. Guest 0 exits a second later.
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
idx=$(sed -n "s/.*seedbox.index=\([0-9]*\).*/\1/p" /proc/cmdline)
n=$(sed -n "s/.*window.n=\([0-9]*\).*/\1/p" /proc/cmdline)
work=$(sed -n "s/.*window.work=\([0-9]*\).*/\1/p" /proc/cmdline)
ip link set lo up
ip addr add 10.0.0.$((idx+1))/24 dev eth0
ip link set eth0 up
peer=$(( (idx+1) % n + 1 ))
( dd if=/dev/zero bs=64k count=${work:-0} 2>/dev/null | sha256sum > /tmp/work ) &
ping -c 100 -i 0.02 -q 10.0.0.$peer > /tmp/ping 2>&1
wait
echo "$idx work $(cat /tmp/work) $(grep packets /tmp/ping)"
if [ "$idx" = 0 ]; then sleep 1; sbx exit 0; fi
while true; do sleep 10; done
