#!/bin/busybox sh
# Retained-disk probes on /dev/vda: the raw-block probe (guest/blkprobe.c),
# or with seedbox.blk=ext4 the fsync ledger (guest/fsledger.c) on ext4.
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mode=$(sed -n 's/.*seedbox\.blk=\([^ ]*\).*/\1/p' /proc/cmdline)
echo "disk: $(cat /sys/block/vda/size) sectors, write cache $(cat /sys/block/vda/queue/write_cache), fua $(cat /sys/block/vda/queue/fua)"
if [ "$mode" = ext4 ]; then
  mkdir -p /mnt
  mount -t ext4 /dev/vda /mnt || sbx exit 2
  fsledger && code=0 || code=$?
else
  blkprobe $mode && code=0 || code=$?
fi
sbx exit $code
