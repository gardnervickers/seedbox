#!/bin/busybox sh
# Random bytes before and after a fork: a time fork (entropy-fork.json) or the
# launch barrier (entropy-barrier.json; sbx barrier is a no-op otherwise).
/bin/busybox --install -s
mount -t proc proc /proc
mount -t devtmpfs devtmpfs /dev
echo "before fork: getrandom=$(rngprobe) urandom=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
sbx barrier || exit 1
sleep 3
echo "after fork: getrandom=$(rngprobe) urandom=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
sbx exit 0
