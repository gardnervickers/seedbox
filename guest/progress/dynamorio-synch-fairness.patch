diff --git a/core/synch.c b/core/synch.c
index 2d5c58f..e583f52 100644
--- a/core/synch.c
+++ b/core/synch.c
@@ -882,6 +882,12 @@ set_synched_thread_context(thread_record_t *trec,
 #define SYNCH_ALL_THREADS_MAXIMUM_LOOPS (DYNAMO_OPTION(synch_all_threads_max_loops))
 #define SYNCH_MAXIMUM_LOOPS (DYNAMO_OPTION(synch_thread_max_loops))
 
+/* Threads spinning to acquire all_threads_synch_lock, and how many times a thread
+ * starting synch_with_all_threads yields to them first.
+ */
+static volatile int synch_all_waiters;
+#define SYNCH_ALL_DEFER_MAX 100
+
 /* Amt of time in ms to wait for threads to get to a safe spot per a loop,
  * see comments in synch_with_yield() on value.  Our default value is 5ms which,
  * depending on the tick resolution could end up being as long as 10 ms. */
@@ -1292,6 +1298,28 @@ synch_with_all_threads(thread_synch_state_t desired_synch_state,
         " Giving %d permission and seeking %d state\n",
         my_id, cur_state, desired_synch_state);
 
+    /* Let threads already waiting for all_threads_synch_lock go first, waiting at
+     * a safe spot so that they can synch with us.  A thread that synchs over and
+     * over, such as one flushing for each of an app's code writes, otherwise wins
+     * every trylock below and starves a waiter such as a forking thread.  The
+     * deferral is bounded, so two such threads cannot defer to each other forever.
+     */
+    for (i = 0; i < SYNCH_ALL_DEFER_MAX && atomic_aligned_read_int(&synch_all_waiters) > 0;
+         i++) {
+        if (dcontext != NULL && cur_state != THREAD_SYNCH_NONE &&
+            should_wait_at_safe_spot(dcontext)) {
+            if (dcontext->is_exiting) {
+                ASSERT(exiting_thread_count >= 1);
+                ATOMIC_DEC(int, exiting_thread_count);
+            }
+            check_wait_at_safe_spot(dcontext, cur_state);
+            if (dcontext->is_exiting) {
+                ATOMIC_INC(int, exiting_thread_count);
+            }
+        }
+        os_thread_yield();
+    }
+
     /* grab all_threads_synch_lock */
     /* since all_threads synch doesn't give any permissions this is necessary
      * to prevent deadlock in the case of two threads trying to synch with all
@@ -1301,7 +1329,12 @@ synch_with_all_threads(thread_synch_state_t desired_synch_state,
      * race conditions in doing so?
      * Ditto on all other os_thread_yields in this file!
      */
+    bool counted_waiter = false;
     while (!d_r_mutex_trylock(&all_threads_synch_lock)) {
+        if (!counted_waiter) {
+            ATOMIC_INC(int, synch_all_waiters);
+            counted_waiter = true;
+        }
         LOG(THREAD, LOG_SYNCH, 2, "Spinning on all threads synch lock\n");
         STATS_INC(synch_yields);
         if (dcontext != NULL && cur_state != THREAD_SYNCH_NONE &&
@@ -1329,6 +1362,8 @@ synch_with_all_threads(thread_synch_state_t desired_synch_state,
         if (INTERNAL_OPTION(single_thread_in_DR))
             ENTERING_DR(); /* re-gain DR exclusion lock */
     }
+    if (counted_waiter)
+        ATOMIC_DEC(int, synch_all_waiters);
 
     d_r_mutex_lock(&thread_initexit_lock);
     /* synch with all threads */
