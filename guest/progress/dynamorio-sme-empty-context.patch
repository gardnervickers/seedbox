+/* Linux arm64 restore_sve_fpsimd_context explicitly accepts this SME-only,
+ * non-streaming header with no payload (VL=0). FPSIMD owns all vector state;
+ * leave the header and following records intact rather than inventing SVE state.
+ * A populated, streaming, truncated or differing-VL record is NOT this case.
+ */
+static bool
+sve_is_non_sve_fpsimd_header(const struct sve_context *sve, size_t available,
+                            bool has_sve)
+{
+    return !has_sve && available >= sizeof(*sve) && sve->head.magic == SVE_MAGIC &&
+        sve->head.size == sizeof(*sve) && sve->vl == 0 && sve->flags == 0;
+}
+
 void
 mcontext_to_sigcontext_simd(sig_full_cxt_t *sc_full, priv_mcontext_t *mc)
 {
