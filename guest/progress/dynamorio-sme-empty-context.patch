+#ifdef STANDALONE_UNIT_TEST
+void
+unit_test_non_sve_signal_context(void)
+{
+    struct sve_context header = { 0 };
+    header.head.magic = SVE_MAGIC;
+    header.head.size = sizeof(header);
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), false), true);
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header) - 1, false), false);
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), true), false);
+    header.flags = 1; /* streaming state is never classified as FPSIMD-only */
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), false), false);
+    header.flags = 0;
+    header.vl = 16;
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), false), false);
+    header.vl = 0;
+    header.head.size += 16;
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header) + 16, false), false);
+    header.head.size = 8;
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), false), false);
+    header.head.size = sizeof(header);
+    header.head.magic = 0;
+    EXPECT(sve_is_non_sve_fpsimd_header(&header, sizeof(header), false), false);
+    header.head.magic = SVE_MAGIC;
+    if (!proc_has_feature(FEATURE_SVE)) {
+        sigcontext_t sc = { 0 };
+        sig_full_cxt_t full = { 0 };
+        full.sc = &sc;
+        full.fp_simd_state = sc.__reserved;
+        struct fpsimd_context *fp = (void *)sc.__reserved;
+        fp->head.magic = FPSIMD_MAGIC;
+        fp->head.size = sizeof(*fp);
+        struct sve_context *sve = (void *)(fp + 1);
+        *sve = header;
+        struct _aarch64_ctx *tail = (void *)(sve + 1);
+        tail->magic = 0x54504902; /* A following TPIDR2 header is not shifted. */
+        tail->size = 16;
+        priv_mcontext_t before = { 0 }, after = { 0 };
+        before.fpsr = 0x08000000;
+        before.fpcr = 0x00400000;
+        for (int i = 0; i < MCXT_NUM_SIMD_SVE_SLOTS; ++i)
+            memset(&before.simd[i].q, i + 1, sizeof(before.simd[i].q));
+        mcontext_to_sigcontext_simd(&full, &before);
+        EXPECT(memcmp(sve, &header, sizeof(header)), 0);
+        EXPECT(tail->magic, 0x54504902);
+        EXPECT(tail->size, 16);
+        sigcontext_to_mcontext_simd(&after, &full);
+        EXPECT(after.fpsr, before.fpsr);
+        EXPECT(after.fpcr, before.fpcr);
+        for (int i = 0; i < MCXT_NUM_SIMD_SVE_SLOTS; ++i)
+            EXPECT(memcmp(&after.simd[i].q, &before.simd[i].q,
+                          sizeof(before.simd[i].q)), 0);
+    }
+    print_file(STDERR, "non-SVE signal header: passed\n");
+}
+#endif
