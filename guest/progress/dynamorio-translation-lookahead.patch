+
+#if defined(STANDALONE_UNIT_TEST) && defined(AARCH64)
+void
+unit_test_translate_restore_lookahead(dcontext_t *dc)
+{
+    reg_id_t old_stolen = dr_reg_stolen;
+    dr_reg_stolen = DR_REG_X28;
+    dr_isa_mode_t old_mode;
+    EXPECT(dr_set_isa_mode(dc, DR_ISA_ARM_A64, &old_mode), true);
+    byte buf[16];
+    instr_t *nop = INSTR_CREATE_nop(dc);
+    instr_t *restore = instr_create_restore_from_tls(dc, DR_REG_X0, TLS_REG0_SLOT);
+    instr_set_next(nop, restore);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, NULL, NULL), true);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X1, NULL, NULL), false);
+    EXPECT(instr_encode(dc, nop, buf), buf + 4);
+    EXPECT(instr_encode(dc, restore, buf + 4), buf + 8);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf + 8), true);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X1, buf, buf + 8), false);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf + 7), false);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf + 4), false);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf), false);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, NULL), false);
+    instr_set_next(nop, NULL);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, NULL, NULL), false);
+    instr_destroy(dc, restore);
+    instr_t *spill = instr_create_save_to_tls(dc, DR_REG_X0, TLS_REG0_SLOT);
+    instr_set_next(nop, spill);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, NULL, NULL), false);
+    EXPECT(instr_encode(dc, spill, buf + 4), buf + 8);
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf + 8), false);
+    memset(buf + 4, 0, 4); /* UDF: decoder rejects this encoding. */
+    EXPECT(translate_restore_lookahead(dc, nop, DR_REG_X0, buf, buf + 8), false);
+    instr_set_next(nop, NULL);
+    instr_destroy(dc, nop);
+    instr_destroy(dc, spill);
+    dr_set_isa_mode(dc, old_mode, NULL);
+    dr_reg_stolen = old_stolen;
+    print_file(STDERR, "translate restore lookahead tests passed\n");
+}
+#endif
