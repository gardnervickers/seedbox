+#if defined(AARCH64) && (defined(DEBUG) || defined(STANDALONE_UNIT_TEST))
+/* The ilist walker has successor links; the stored-info walker decodes a
+ * singleton. In the latter case inspect only the caller-owned fragment body,
+ * never app source, exit stubs, or the selfmod copy. The reconstruction caller
+ * already retains f and its cache bytes under its synchronization contract.
+ * Copy one complete A64 encoding before decoding so a truncated end is rejected.
+ */
+static bool
+translate_restore_lookahead(dcontext_t *dc, instr_t *inst, reg_id_t wanted,
+                            cache_pc current, cache_pc body_end)
+{
+    instr_t decoded;
+    bool found = false;
+    instr_init(dc, &decoded);
+    for (instr_t *curr = inst; curr != NULL;) {
+        bool tls, spill;
+        reg_id_t reg;
+        if (current != NULL) {
+            uint word;
+            if (body_end == NULL || current >= body_end || body_end - current < 4 ||
+                !ALIGNED(current, 4))
+                break;
+            memcpy(&word, current, sizeof(word));
+            instr_reset(dc, &decoded);
+            if (decode_from_copy(dc, (byte *)&word, current, &decoded) == NULL)
+                break;
+            curr = &decoded;
+        }
+        if (instr_is_DR_reg_spill_or_restore(dc, curr, &tls, &spill, &reg, NULL) &&
+            reg == wanted) {
+            found = !spill && tls;
+            break;
+        }
+        if (current != NULL)
+            current += 4;
+        else
+            curr = instr_get_next(curr);
+    }
+    instr_free(dc, &decoded);
+    return found;
+}
+#endif
