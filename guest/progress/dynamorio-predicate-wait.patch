+                      priv_mcontext_t *mc)
+{
+    dcontext_t *dcontext = get_thread_private_dcontext();
+    ASSERT(dcontext != NULL && !IS_CLIENT_THREAD(dcontext));
+    ASSERT_OWN_NO_LOCKS();
+    /* Same ownership and synch_lock transition discipline as the application
+     * recursive-lock wait below. mc was obtained with dr_get_mcontext: raw
+     * dstack bytes would have the wrong app SP and stolen register. No heap or
+     * generation record is needed: the private operation can be abandoned. */
+    *get_mcontext(dcontext) = *mc;
+    LOG(THREAD, LOG_SYNCH, 1, "predicate-wait owned pc=" PFX " sp=" PFX "\n",
+        mc->pc, mc->xsp);
+    set_synch_state(dcontext, THREAD_SYNCH_VALID_MCONTEXT);
+    __atomic_store_n(acknowledgement, value, __ATOMIC_RELEASE);
+    dynamorio_syscall(SYS_futex, 6, acknowledgement, 129 /* FUTEX_WAKE_PRIVATE */,
+                      1, NULL, NULL, 0);
+    while (__atomic_load_n(predicate, __ATOMIC_ACQUIRE) == value) {
+        /* EINTR and spurious wakes simply recheck: there is no consumed result. */
+        dynamorio_syscall(SYS_futex, 6, predicate, 128 /* FUTEX_WAIT_PRIVATE */,
+                          value, NULL, NULL, 0);
+    }
+    set_synch_state(dcontext, THREAD_SYNCH_NONE);
+    LOG(THREAD, LOG_SYNCH, 1, "predicate-wait complete pc=" PFX "\n", mc->pc);
