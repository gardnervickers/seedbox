+static void
+source_span_index(source_span_t *span, fragment_source_t *source)
+{
+    uint prot;
+    span->owner = source;
+    if (!source_address_key(span->pc, &span->key, &span->trusted, &prot)) {
+        /* A successfully queried preexisting anonymous VMA cannot alias a
+         * fresh private anonymous birth. A failed query proves no such thing. */
+        source->unresolved |= source_map(span->pc) == NULL;
+        return;
+    }
+    span->trusted &= TESTALL(MEMPROT_READ | MEMPROT_EXEC, prot);
+    uint bucket = source_key_hash(span->key);
+    span->index_next = source_index[bucket];
+    if (span->index_next != NULL)
+        span->index_next->index_prev = span;
+    source_index[bucket] = span;
+    span->indexed = true;
+}
+
+static void
+source_span_unindex(source_span_t *span)
+{
+    if (!span->indexed)
+        return;
+    if (span->index_prev != NULL)
+        span->index_prev->index_next = span->index_next;
+    else
+        source_index[source_key_hash(span->key)] = span->index_next;
+    if (span->index_next != NULL)
+        span->index_next->index_prev = span->index_prev;
+}
