+/* Lock order uses the no-allocation /proc iterator. Allocate only after stop.
+ * Cache queried VMAs until the next intercepted mapping transition. */
+static source_mapping_t *
+source_map(app_pc pc)
+{
+    for (source_mapping_t *m = source_maps; m != NULL; m = m->next) {
+        if (pc >= m->begin && pc < m->end)
+            return m;
+    }
+    source_mapping_t found = { 0 };
+    memquery_iter_t iter;
+    source_queries++;
+    if (!memquery_iterator_start(&iter, pc, false))
+        return NULL;
+    while (memquery_iterator_next(&iter)) {
+        if (pc >= iter.vm_start && pc < iter.vm_end) {
+            found.begin = iter.vm_start;
+            found.end = iter.vm_end;
+            found.prot = iter.prot;
+            found.inode = iter.inode;
+            found.major = iter.device_major;
+            found.minor = iter.device_minor;
+            found.offset = iter.offset;
+            found.shared = iter.is_shared;
+            break;
+        }
+    }
+    memquery_iterator_stop(&iter);
+    if (found.end == NULL)
+        return NULL;
+    /* A query outside an observed birth must not cache a merged anonymous
+     * VMA over that birth and hide its identity from a later query. */
+    app_pc original_begin = found.begin;
+    for (source_mapping_t *birth = source_births; birth != NULL; birth = birth->next) {
+        if (birth->end <= pc)
+            found.begin = MAX(found.begin, birth->end);
+        else if (birth->begin > pc)
+            found.end = MIN(found.end, birth->begin);
+    }
+    found.offset += found.begin - original_begin;
+    for (source_mapping_t *birth = source_births; birth != NULL; birth = birth->next) {
+        if (pc < birth->begin || pc >= birth->end)
+            continue;
+        /* Clamp a merged VMA to the interval whose birth we actually observed. */
+        app_pc start = MAX(found.begin, birth->begin);
+        found.offset += start - found.begin;
+        found.begin = start;
+        found.end = MIN(found.end, birth->end);
+        if (birth->birth != 0 && found.inode == 0 && !found.shared) {
+            found.birth = birth->birth;
+            found.trusted = true;
+        } else if (birth->inode != 0 && birth->inode == found.inode &&
+                   birth->major == found.major && birth->minor == found.minor) {
+            found.trusted = found.shared;
+        }
