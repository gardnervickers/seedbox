+/* Bracket kernel mapping operations without holding a lock across a syscall.
+ * A concurrent builder remains conservatively invalid until completion; failed
+ * and skipped operations revoke too. There is no wait on a blocked application. */
+void
+fragment_source_mutation_begin(dcontext_t *dc, app_pc begin, size_t size,
+                               bool revoke_all, bool disable)
+{
+    if (!DYNAMO_OPTION(seedbox_icache_images))
+        return;
+    d_r_mutex_lock(&fragment_source_lock);
+    ASSERT(!dc->source_mutation);
+    dc->source_mutation = true;
+    source_mutations++;
+    source_invalidated = true;
+    ++source_incarnation;
+    source_maps_clear(&source_maps);
+    app_pc end = size > POINTER_MAX - (ptr_uint_t)begin ? NULL : begin + size;
+    if (revoke_all || size != 0)
+        source_births_revoke(begin, revoke_all ? NULL : end);
+    source_index_disabled |= disable;
+    d_r_mutex_unlock(&fragment_source_lock);
+}
+
+void
+fragment_source_mutation_end(dcontext_t *dc, app_pc birth, size_t size,
+                             bool anonymous, uint64 inode, uint major, uint minor)
+{
+    if (!DYNAMO_OPTION(seedbox_icache_images) || !dc->source_mutation)
+        return;
+    d_r_mutex_lock(&fragment_source_lock);
+    ASSERT(source_mutations > 0);
+    --source_mutations;
+    dc->source_mutation = false;
+    ++source_incarnation;
+    source_invalidated = true;
+    source_maps_clear(&source_maps);
+    if (birth != NULL && size != 0 && size <= POINTER_MAX - (ptr_uint_t)birth &&
+        size <= POINTER_MAX - (PAGE_SIZE - 1) && (anonymous || inode != 0)) {
+        size = ALIGN_FORWARD(size, PAGE_SIZE);
+        if (size <= POINTER_MAX - (ptr_uint_t)birth) {
+            source_births_revoke(birth, birth + size);
+            source_mapping_t *m = global_heap_alloc(sizeof(*m) HEAPACCT(ACCT_FRAGMENT));
+            memset(m, 0, sizeof(*m));
+            m->begin = birth;
+            m->end = birth + size;
+            m->birth = anonymous ? ++source_birth_id : 0;
+            if (anonymous && source_birth_id == 0)
+                source_index_disabled = true;
+            m->inode = inode;
+            m->major = major;
+            m->minor = minor;
+            m->next = source_births;
+            source_births = m;
+        }
+    }
+    d_r_mutex_unlock(&fragment_source_lock);
+}
