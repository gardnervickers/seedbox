+static bool
+source_address_key(app_pc pc, source_key_t *key, bool *trusted, uint *prot)
+{
+    source_mapping_t *m = source_map(pc);
+    if (m == NULL)
+        return false;
+    *prot = m->prot;
+    *trusted = m->trusted;
+    memset(key, 0, sizeof(*key));
+    key->file = m->inode != 0;
+    if (key->file) {
+        key->identity = m->inode;
+        key->major = m->major;
+        key->minor = m->minor;
+        key->offset = m->offset + (pc - m->begin);
+    } else {
+        if (m->birth == 0)
+            return false;
+        key->identity = m->birth;
+        key->offset = (ptr_uint_t)pc;
+    }
+    key->offset = ALIGN_BACKWARD(key->offset, PAGE_SIZE);
+    return true;
