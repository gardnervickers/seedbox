+/* Return false if ownership is unresolved. Otherwise inspect only indexed
+ * dependencies of this page/line, including RX aliases of an RW IC operand.
+ * Private file/COW spans are indexed conservatively, never admitted equal. */
+static bool
+source_line_select(app_pc begin, app_pc end, bool select, bool *changed)
+{
+    source_key_t key;
+    bool trusted;
+    uint prot;
+    if (source_index_disabled || source_mutations != 0 || source_unresolved != 0 ||
+        source_invalidated ||
+        end == NULL || end <= begin || PAGE_START(begin) != PAGE_START(end - 1) ||
+        !source_address_key(begin, &key, &trusted, &prot) || !trusted)
+        return false;
+    uint low = (ptr_uint_t)begin & (PAGE_SIZE - 1);
+    uint high = low + (end - begin);
+    for (source_span_t *span = source_index[source_key_hash(key)]; span != NULL;
+         span = span->index_next) {
+        if (!span->owner->live || !source_key_equal(key, span->key))
+            continue;
+        uint first = (ptr_uint_t)span->pc & (PAGE_SIZE - 1);
+        uint last = first + span->size;
+        if (first >= high || last <= low)
+            continue;
+        uint from = MAX(first, low) - first;
+        uint size = MIN(last, high) - (first + from);
+        byte current[SOURCE_SPAN_CAPACITY];
+        source_scanned_bytes += size;
+        bool hit = !span->trusted || span->owner->incarnation != source_incarnation ||
+            !d_r_safe_read(span->pc + from, size, current) ||
+            memcmp(current, span->bytes + from, size) != 0;
+        if (hit) {
+            *changed = true;
+            if (select)
+                span->owner->selected = true;
+        }
+    }
+    return true;
+}
