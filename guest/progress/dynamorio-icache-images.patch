+void
+fragment_source_icache(dcontext_t *dcontext, app_pc begin, app_pc end)
+{
+    ASSERT(begin < end || end == NULL);
+    bool unchanged = true;
+    bool precise = DYNAMO_OPTION(disable_traces) && !DYNAMO_OPTION(coarse_units);
