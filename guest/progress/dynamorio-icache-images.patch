+#ifdef AARCH64
+/* This is a correctness/lifetime discriminator, not an indexed JIT fast path.
+ * Every IC compares ALL live source images, including executable aliases outside
+ * the named line. The platform's normal DSB/IC publication contract still applies.
+ * The builder decodes from these immutable bytes, never from a later reread.
+ * Mapping changes retain the existing VM/syscall flush protocol and revoke equality
+ * admission through an additional global incarnation. Equality is not permission.
+ */
+#define SOURCE_SPAN_CAPACITY 256
+typedef struct _source_span_t {
+    struct _source_span_t *next;
+    app_pc pc;
+    uint size;
+    byte bytes[SOURCE_SPAN_CAPACITY];
+} source_span_t;
+struct _fragment_source_t {
+    struct _fragment_source_t *next, *prev;
+    source_span_t *first, *last;
+    uint64 incarnation;
+    bool published, live, selected;
+};
+DECLARE_CXTSWPROT_VAR(static mutex_t fragment_source_lock, INIT_LOCK_FREE(fragment_source_lock));
+DECLARE_NEVERPROT_VAR(static fragment_source_t *fragment_sources, NULL);
+DECLARE_NEVERPROT_VAR(static uint64 source_incarnation, 1);
+/* Only the all-thread owner reads/writes this while it owns the collection. */
+DECLARE_NEVERPROT_VAR(static bool source_selective_flush, false);
+DECLARE_NEVERPROT_VAR(static uint64 source_ics, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_admissions, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_scanned_bytes, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_scan_us, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_emitted, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_reclaimed, 0);
+DECLARE_NEVERPROT_VAR(static uint64 source_selected, 0);
+
+fragment_source_t *
+fragment_source_create(void)
+{
+    fragment_source_t *source = global_heap_alloc(sizeof(*source) HEAPACCT(ACCT_FRAGMENT));
+    memset(source, 0, sizeof(*source));
+    d_r_mutex_lock(&fragment_source_lock);
+    source->incarnation = source_incarnation;
+    d_r_mutex_unlock(&fragment_source_lock);
+    return source;
+}
+
+byte *
+fragment_source_decode(dcontext_t *dcontext, fragment_source_t **owner, app_pc pc,
+                       instr_t *instr)
+{
+    if (*owner == NULL)
+        *owner = fragment_source_create();
+    fragment_source_t *source = *owner;
+    source_span_t *span = source->last;
+    if (span == NULL || span->pc + span->size != pc ||
+        span->size == SOURCE_SPAN_CAPACITY ||
+        PAGE_START(span->pc) != PAGE_START(pc)) {
+        span = global_heap_alloc(sizeof(*span) HEAPACCT(ACCT_FRAGMENT));
+        memset(span, 0, sizeof(*span));
+        span->pc = pc;
+        if (source->last == NULL)
+            source->first = span;
+        else
+            source->last->next = span;
+        source->last = span;
+    }
+    byte *copy = span->bytes + span->size;
+    /* ARM instructions are aligned words. A fault uses the existing bb abort
+     * path, which owns this span already. unsafe_build_ldstex uses the old decoder
+     * and receives unknown ownership rather than claiming a partial image. */
+    *(uint *)copy = *(const uint *)pc;
+    span->size += AARCH64_INSTR_SIZE;
+    byte *next = decode_from_copy(dcontext, copy, pc, instr);
+    return next == NULL ? NULL : pc + AARCH64_INSTR_SIZE;
+}
+
+void
+fragment_source_publish(fragment_t *f, fragment_source_t *source)
+{
+    if (source == NULL)
+        source = fragment_source_create(); /* unknown => must invalidate */
+    f->source = source;
+    d_r_mutex_lock(&fragment_source_lock);
+    source->published = source->live = true;
+    source->next = fragment_sources;
+    if (fragment_sources != NULL)
+        fragment_sources->prev = source;
+    fragment_sources = source;
+    source_emitted++;
+    d_r_mutex_unlock(&fragment_source_lock);
+}
+
+static void
+fragment_source_retire(fragment_t *f)
+{
+    if (f->source == NULL)
+        return;
+    d_r_mutex_lock(&fragment_source_lock);
+    f->source->live = false;
+    d_r_mutex_unlock(&fragment_source_lock);
+}
+
+void
+fragment_source_destroy(fragment_source_t *source)
+{
+    if (source == NULL)
+        return;
+    d_r_mutex_lock(&fragment_source_lock);
+    if (source->published) {
+        if (source->prev != NULL)
+            source->prev->next = source->next;
+        else
+            fragment_sources = source->next;
+        if (source->next != NULL)
+            source->next->prev = source->prev;
+        source_reclaimed++;
+    }
+    d_r_mutex_unlock(&fragment_source_lock);
+    source_span_t *span = source->first;
+    while (span != NULL) {
+        source_span_t *next = span->next;
+        global_heap_free(span, sizeof(*span) HEAPACCT(ACCT_FRAGMENT));
+        span = next;
+    }
+    global_heap_free(source, sizeof(*source) HEAPACCT(ACCT_FRAGMENT));
+}
+
+void
+fragment_source_mapping_changed(void)
+{
+    if (!DYNAMO_OPTION(seedbox_icache_images))
+        return;
+    d_r_mutex_lock(&fragment_source_lock);
+    ++source_incarnation;
+    /* Never let a wrapped incarnation bless an old image. */
+    if (source_incarnation == 0) {
+        for (fragment_source_t *s = fragment_sources; s != NULL; s = s->next)
+            s->incarnation = 0;
+        source_incarnation = 1;
+    }
+    d_r_mutex_unlock(&fragment_source_lock);
+}
+
+static bool
+fragment_source_unchanged(fragment_source_t *source)
+{
+    ASSERT_OWN_MUTEX(true, &fragment_source_lock);
+    if (source->first == NULL || source->incarnation != source_incarnation)
+        return false;
+    for (source_span_t *span = source->first; span != NULL; span = span->next) {
+        dr_mem_info_t info;
+        byte current[SOURCE_SPAN_CAPACITY];
+        if (!query_memory_ex(span->pc, &info) ||
+            !TESTALL(MEMPROT_READ | MEMPROT_EXEC, info.prot) ||
+            span->pc < info.base_pc || span->size > info.size ||
+            span->pc - info.base_pc > info.size - span->size)
+            return false;
+        source_scanned_bytes += span->size;
+        if (!d_r_safe_read(span->pc, span->size, current) ||
+            memcmp(current, span->bytes, span->size) != 0)
+            return false;
+    }
+    return true;
+}
+
+/* Called under the full synchronization before any fragment/IBL deletion. */
+static void
+fragment_source_select(void)
+{
+    uint64 start = query_time_micros();
+    d_r_mutex_lock(&fragment_source_lock);
+    for (fragment_source_t *s = fragment_sources; s != NULL; s = s->next) {
+        s->selected = s->live && !fragment_source_unchanged(s);
+        source_selected += s->selected;
+    }
+    source_scan_us += query_time_micros() - start;
+    d_r_mutex_unlock(&fragment_source_lock);
+}
+
+bool
+fragment_source_flushing(void)
+{
+    return source_selective_flush && is_self_allsynch_flushing();
+}
+
+bool
+fragment_source_selected(fragment_t *f)
+{
+    ASSERT(fragment_source_flushing());
+    return f->source == NULL || f->source->selected;
+}
