+#ifdef STANDALONE_UNIT_TEST
+void
+unit_test_fragment_source(dcontext_t *dc)
+{
+    byte *code = heap_mmap(2 * PAGE_SIZE, MEMPROT_READ | MEMPROT_WRITE | MEMPROT_EXEC,
+                           VMM_SPECIAL_MMAP);
+    EXPECT(code != NULL, true);
+    uint *word = (uint *)code;
+    word[0] = 0x11000800; /* add w0,w0,#2 */
+    word[1] = 0xd65f03c0;
+    word[32] = 0x528003c0;
+    *(uint *)(code + PAGE_SIZE - 4) = 0x52800080;
+    *(uint *)(code + PAGE_SIZE) = 0x11000c00;
+    fragment_source_t *source = NULL;
+    instr_t instr;
+    instr_init(dc, &instr);
+    EXPECT(fragment_source_decode(dc, &source, code, &instr), code + 4);
+    EXPECT(instr_get_opcode(&instr), OP_add);
+    word[0] = 0x52800020;
+    EXPECT(*(uint *)source->first->bytes, 0x11000800);
+    EXPECT(instr_get_opcode(&instr), OP_add); /* decoded OLD image */
+    instr_reset(dc, &instr);
+    fragment_source_decode(dc, &source, code + 128, &instr);
+    EXPECT(source->first->next->pc, code + 128);
+    instr_reset(dc, &instr);
+    fragment_source_decode(dc, &source, code + PAGE_SIZE - 4, &instr);
+    instr_reset(dc, &instr);
+    fragment_source_decode(dc, &source, code + PAGE_SIZE, &instr);
+    EXPECT(source->last->pc, code + PAGE_SIZE);
+    instr_reset(dc, &instr);
+    d_r_mutex_lock(&fragment_source_lock);
+    EXPECT(fragment_source_unchanged(source), false);
+    word[0] = 0x11000800;
+    EXPECT(fragment_source_unchanged(source), true);
+    word[8] = 0x528009a0; /* unrelated same-line bytes */
+    EXPECT(fragment_source_unchanged(source), true);
+    source->incarnation--;
+    EXPECT(fragment_source_unchanged(source), false);
+    source->incarnation++;
+    d_r_mutex_unlock(&fragment_source_lock);
+    fragment_t f = { 0 };
+    fragment_source_publish(&f, source);
+    EXPECT(f.source, source);
+    fragment_source_retire(&f);
+    EXPECT(source->live, false);
+    uint64 reclaimed = source_reclaimed;
+    fragment_source_destroy(source);
+    EXPECT(source_reclaimed, reclaimed + 1);
+    /* Unknown and non-executable images never receive equality admission. */
+    source = fragment_source_create();
+    d_r_mutex_lock(&fragment_source_lock);
+    EXPECT(fragment_source_unchanged(source), false);
+    d_r_mutex_unlock(&fragment_source_lock);
+    fragment_source_destroy(source);
+    uint nonexec = 0xd65f03c0;
+    source = NULL;
+    fragment_source_decode(dc, &source, (byte *)&nonexec, &instr);
+    instr_reset(dc, &instr);
+    d_r_mutex_lock(&fragment_source_lock);
+    EXPECT(fragment_source_unchanged(source), false);
+    d_r_mutex_unlock(&fragment_source_lock);
+    fragment_source_destroy(source);
+    heap_munmap(code, 2 * PAGE_SIZE, VMM_SPECIAL_MMAP);
+    print_file(STDERR, "fragment source images: passed\n");
+}
+#endif
