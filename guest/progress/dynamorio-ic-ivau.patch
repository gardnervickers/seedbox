 #define UNIVERSAL_REGION_SIZE POINTER_MAX
 /* really open-ended would make this wrap around to 0 */
 #define UNIVERSAL_REGION_END ((app_pc)POINTER_MAX)

+/* Query ends may be NULL for the open top of the address space. Stored
+ * vmareas still have numeric, non-NULL ends (add_vm_area's existing contract).
+ * POINTER_MAX remains an ordinary exclusive end, not an alias for NULL.
+ */
+static inline bool
+vm_area_query_overlaps(app_pc start, app_pc end, app_pc area_start, app_pc area_end)
+{
+    return start < area_end && (end == NULL || end > area_start);
+}
+
+static inline void
+vm_area_expand_to_page(app_pc *start, app_pc *end, size_t page_size)
+{
+    *start = (app_pc)ALIGN_BACKWARD(*start, page_size);
+    if (*end != NULL && (ptr_uint_t)*end <= POINTER_MAX - (page_size - 1))
+        *end = (app_pc)ALIGN_FORWARD(*end, page_size);
+}
+
