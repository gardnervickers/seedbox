diff --git a/core/arch/aarchxx/mangle.c b/core/arch/aarchxx/mangle.c
index bd5a6dd..73ed2ce 100644
--- a/core/arch/aarchxx/mangle.c
+++ b/core/arch/aarchxx/mangle.c
@@ -146,6 +146,21 @@ insert_save_or_restore_gpr_simd_registers(
             num_regs = (rtype == GPR_REG_TYPE) ? 30 : MCXT_NUM_SIMD_SVE_SLOTS;
     uint saved_regs = 0;
     instr_t *new_instr;
+    if (rtype == SIMD_REG_TYPE && ci == NULL) {
+        /* priv_mcontext_t holds each SIMD register in its own dr_simd_t slot, as
+         * fcache_return saves them. Packed pairs would place odd registers in the
+         * wrong slot for dr_get_mcontext(), dr_set_mcontext() and redirection.
+         */
+        for (i = 0; i < num_regs; i++) {
+            if (reg_skip != NULL && reg_skip[i])
+                continue;
+            opnd_t mem = opnd_create_base_disp(base_reg, DR_REG_NULL, 0,
+                                               i * sizeof(dr_simd_t), OPSZ_16);
+            PRE(ilist, instr,
+                create_load_or_store_instr(dcontext, first_reg + i, mem, save));
+        }
+        return;
+    }
     /* Use stp/ldp to save/restore as many register pairs to memory, skipping
      * registers according to reg_skip.
      */
