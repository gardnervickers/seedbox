+#if defined(LINUX) && defined(AARCH64)
+static void
+progress_require(bool condition, const char *message)
+{
+    if (!condition) {
+        CLIENT_ASSERT(false, message);
+        dr_abort();
+    }
+}
+
+DR_API void
+dr_app_progress_exit(dr_mcontext_t *mc, ptr_int_t *budget, ptr_int_t quantum,
+                     ptr_int_t charged, ptr_int_t (*pay)(void))
+{
+    dcontext_t *dc = get_thread_private_dcontext();
+    progress_require(dc != NULL && !IS_CLIENT_THREAD(dc), "progress needs an app thread");
+    progress_require(mc != NULL && mc->size == sizeof(*mc) && mc->flags == DR_MC_ALL &&
+                      mc->pc != NULL, "progress requires full app context and PC");
+    progress_require(dc->client_data->progress.pay == NULL &&
+                      !dc->client_data->progress_callback_active,
+                  "recursive progress obligation");
+    progress_require(quantum > 0 && quantum <= UINT_MAX && charged > 0 && charged <= UINT_MAX,
+                  "invalid progress quantum or charge");
+    progress_require(pay != NULL && is_in_client_lib_ignore_aux((app_pc)pay),
+                  "progress payment must have stable client-library code");
+    progress_require(os_current_thread_owns_raw_tls(budget),
+                  "progress budget must be this thread's allocated raw TLS");
+    progress_require(*budget < 0, "progress exit must be due");
+    ASSERT_OWN_NO_LOCKS();
+    dc->client_data->progress.resume = mc->pc;
+    dc->client_data->progress.budget = budget;
+    dc->client_data->progress.quantum = quantum;
+    dc->client_data->progress.charged = charged;
+    dc->client_data->progress.payments = 0;
+    dc->client_data->progress.pay = pay;
+    dr_redirect_execution(mc);
+    progress_require(false, "progress redirect returned");
+}
+
+void
+instrument_finish_progress(dcontext_t *dcontext)
+{
+    client_data_t *cd = dcontext->client_data;
+    if (cd->progress.pay == NULL)
+        return;
+    ASSERT_OWN_NO_LOCKS();
+    /* Called after monitor_cache_exit, before pending application signals. The
+     * old clean-call stack has been discarded by transfer_to_dispatch. */
+    ASSERT(dcontext->last_exit == get_client_linkstub() || LINKSTUB_FAKE(dcontext->last_exit));
+    ASSERT(dcontext->next_tag == cd->progress.resume);
+    ASSERT(get_mcontext(dcontext)->pc == cd->progress.resume);
+    enter_nolinking(dcontext, NULL, false);
+    LOG(THREAD, LOG_SYNCH, 1,
+        "progress owned pc=" PFX " old_charge=" PIFX " debt=" PIFX "\n",
+        cd->progress.resume, cd->progress.charged, *cd->progress.budget);
+    do {
+        *cd->progress.budget += cd->progress.quantum;
+        LOG(THREAD, LOG_SYNCH, 1, "progress added debt=" PIFX "\n", *cd->progress.budget);
+        cd->progress_callback_active = true;
+        set_synch_state(dcontext, THREAD_SYNCH_VALID_MCONTEXT_NO_XFER);
+        ptr_int_t result = cd->progress.pay();
+        set_synch_state(dcontext, THREAD_SYNCH_NONE);
+        cd->progress_callback_active = false;
+        progress_require(result > 0, "marked progress payment failed");
+        ++cd->progress.payments;
+        LOG(THREAD, LOG_SYNCH, 1, "progress paid count=%u result=" PIFX " debt=" PIFX "\n",
+            cd->progress.payments, result, *cd->progress.budget);
+    } while (*cd->progress.budget < 0);
+    *cd->progress.budget += cd->progress.charged;
+    LOG(THREAD, LOG_SYNCH, 1,
+        "progress refunded pc=" PFX " old_charge=" PIFX " debt=" PIFX " payments=%u\n",
+        cd->progress.resume, cd->progress.charged, *cd->progress.budget,
+        cd->progress.payments);
+    memset(&cd->progress, 0, sizeof(cd->progress));
+    LOG(THREAD, LOG_SYNCH, 1, "progress record released\n");
+    enter_couldbelinking(dcontext, NULL, false);
+}
+#endif

