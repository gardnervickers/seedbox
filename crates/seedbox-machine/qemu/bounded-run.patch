+
+void qmp_seedbox_advance(int64_t time, Error **errp)
+{
+    int64_t now = icount_get();
+    int64_t delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                               QEMU_TIMER_ATTR_ALL);
+    if (runstate_is_running() || seedbox_active || time < now ||
+        (delay >= 0 && time - now > delay)) {
+        error_setg(errp, "advance requires a stopped VM and must not skip a timer");
+        return;
+    }
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set(&timers_state.qemu_icount_bias,
+                timers_state.qemu_icount_bias + time - now);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+}
+
+void qmp_seedbox_run(int64_t time, int64_t budget, Error **errp)
+{
+    int64_t now = icount_get();
+    int64_t count = icount_get_raw();
+
+    /* Single CPU keeps this first implementation's instruction/time mapping
+     * explicit. Multi-CPU scheduling is not part of the reference contract. */
+    if (icount_enabled() != ICOUNT_PRECISE ||
+        timers_state.icount_time_shift != 0 || icount_sleep ||
+        icount_align_option || replay_mode != REPLAY_MODE_NONE ||
+        !first_cpu || CPU_NEXT(first_cpu)) {
+        error_setg(errp, "seedbox-run needs one CPU and icount shift=0,align=off,sleep=off");
+        return;
+    }
+    if (runstate_is_running() || seedbox_active ||
+        runstate_check(RUN_STATE_SHUTDOWN)) {
+        error_setg(errp, "seedbox-run requires a stopped, non-exited machine");
+        return;
+    }
+    if (time < now || budget <= 0 || budget > INT64_MAX - time ||
+        budget > INT64_MAX - count) {
+        error_setg(errp, "invalid simulation time or instruction budget");
+        return;
+    }
+    if (!seedbox_controlled) {
+        qemu_add_vm_change_state_handler(seedbox_state_changed, NULL);
+        seedbox_controlled = true;
+    }
+    /* The coordinator explicitly advances idle time; this bias is already
+     * included in QEMU's timer migration state. No guest instruction runs. */
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set(&timers_state.qemu_icount_bias,
+                timers_state.qemu_icount_bias + time - now);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    seedbox_target = count + budget;
+    seedbox_deadline = -1;
+    seedbox_reason = SEEDBOX_STOP_REASON_ERROR;
+    seedbox_active = true;
+    vm_start();
+    /* Service events due at the supplied wake time before classifying idle. */
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+}
+
+SeedboxRunResult *qmp_query_seedbox_run(Error **errp)
+{
+    SeedboxRunResult *result;
+    if (runstate_is_running() || seedbox_active) {
+        error_setg(errp, "seedbox result requires a completed stop");
+        return NULL;
+    }
+    result = g_new0(SeedboxRunResult, 1);
+    result->reason = seedbox_reason;
+    result->time = icount_get();
+    result->has_deadline = seedbox_reason == SEEDBOX_STOP_REASON_BLOCKED &&
+                           seedbox_deadline >= 0;
+    result->deadline = seedbox_deadline;
+    return result;
+}
+
+/* Called by the single TCG CPU thread while preparing a translated-block
+ * budget. icount already splits a block exactly at this instruction limit. */
+int64_t seedbox_icount_limit(int64_t limit)
+{
+    if (seedbox_active) {
+        return MIN(limit, MAX(0, seedbox_target - icount_get_raw()));
+    }
+    return limit;
+}
+
+/* Called under the BQL between CPU executions, never from a translated block.
+ * Stop before the idle loop can wait or the main loop can warp virtual time. */
+void seedbox_icount_poll(void)
+{
+    int64_t delay;
+    if (!seedbox_active || !runstate_is_running()) {
+        return;
+    }
+    if (icount_get_raw() >= seedbox_target) {
+        seedbox_reason = SEEDBOX_STOP_REASON_BOUNDARY;
+    } else if (all_cpu_threads_idle()) {
+        delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                           QEMU_TIMER_ATTR_ALL);
+        if (delay == 0) {
+            qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+            if (!all_cpu_threads_idle()) {
+                return;
+            }
+            delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                               QEMU_TIMER_ATTR_ALL);
+            if (delay == 0) {
+                qemu_notify_event();
+                return;
+            }
+        }
+        seedbox_reason = SEEDBOX_STOP_REASON_BLOCKED;
+        seedbox_deadline = delay < 0 ? -1 : icount_get() + delay;
+    } else {
+        return;
+    }
+    seedbox_active = false;
+    vm_stop(RUN_STATE_PAUSED);
+}
