+
+/* Called only at stopped boundaries under the BQL. */
+static void seedbox_state_changed(void *opaque, bool running, RunState state)
+{
+    if (!running) {
+        seedbox_active = false;
+        if (state == RUN_STATE_SHUTDOWN) {
+            seedbox_reason = SEEDBOX_STOP_REASON_SHUTDOWN;
+        } else if (state != RUN_STATE_PAUSED) {
+            seedbox_reason = SEEDBOX_STOP_REASON_ERROR;
+        }
+    }
