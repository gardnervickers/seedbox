# Dedicated PV guest. Build from allnoconfig, not a general distribution config.
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_SMP=y
# arm64 Kconfig minimum is 2; FDT/nosmp still expose exactly one CPU.
CONFIG_NR_CPUS=2
CONFIG_ARM64_4K_PAGES=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_TICK_ONESHOT=y
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_OF=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_COMMON_CLK=y
# Runtime FDT/boot arguments are caller-owned; Linux 6.12 has no
# RANDOM_TRUST_* Kconfig symbols.
CONFIG_LOCALVERSION="-seedbox-machine-pv3"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_BUILD_SALT=""
CONFIG_ARM_ARCH_TIMER=n
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=n
CONFIG_ARM_PMU=n
CONFIG_PERF_EVENTS=n
CONFIG_KVM=n
CONFIG_PARAVIRT=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_PCI=n
CONFIG_HW_RANDOM=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=n
CONFIG_STACKPROTECTOR=n
CONFIG_STACKPROTECTOR_STRONG=n
CONFIG_ARM64_PTR_AUTH=n
CONFIG_ARM64_BTI=n
CONFIG_ARM64_SVE=n
CONFIG_ARM64_SME=n
CONFIG_ARM64_MTE=n
# Tagged user pointers through syscalls (prctl PR_SET_TAGGED_ADDR_CTRL), used by
# hardware-assisted sanitizers and tagging allocators; independent of MTE.
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_PSEUDO_NMI=n
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_PM=n
CONFIG_SUSPEND=n
CONFIG_COMPAT=n
CONFIG_MODULES=n
CONFIG_DEBUG_INFO=n
CONFIG_FTRACE=n
CONFIG_KASAN=n
CONFIG_KCSAN=n
CONFIG_UBSAN=n
CONFIG_SECURITY=n
CONFIG_AUDIT=n
CONFIG_NO_HZ_IDLE=n
CONFIG_NO_HZ_FULL=n
CONFIG_PREEMPT_NONE=y

# Application facilities used by the shared guest supervisor.
CONFIG_BINFMT_SCRIPT=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IO_URING=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# Test-controlled kernel panic through /proc/sysrq-trigger; no serial input path.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=n
