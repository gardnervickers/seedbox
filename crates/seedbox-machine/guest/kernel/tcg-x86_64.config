# Standard x86-64 Linux for QEMU TCG's microvm board; no Seedbox PV patches.
# Merged over x86_64_defconfig. The board has one fixed CPU, legacy
# virtio-mmio devices (lifecycle console, disk, NIC), an ISA UART, a CMOS
# RTC and ACPI (power-off, reset and device description).
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# microvm describes virtio-mmio devices in ACPI, or on the command line when
# ACPI is off; both discovery paths are built in.
CONFIG_ACPI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_UNIX=y
# Seedbox block and network devices: /dev/vda (ext4) and a virtio NIC.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_UNIX98_PTYS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IO_URING=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_SMP=n
CONFIG_MODULES=n
CONFIG_KVM=n
# qboot is a legacy BIOS; there is no UEFI. With EFI built in, Linux 6.12's
# reboot_init sees hardware-reduced ACPI, efi_reboot_required() and runtime
# services "not disabled", and selects BOOT_EFI. That call fails without UEFI
# and falls through to BOOT_BIOS (re-entering qboot in place), skipping the
# FADT's ACPI GED reset register. Without EFI, reboot and panic use ACPI reset.
CONFIG_EFI=n
# No hypervisor paravirtualization: the guest sees only emulated hardware.
CONFIG_HYPERVISOR_GUEST=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_LOCALVERSION="-seedbox-tcg"
CONFIG_LOCALVERSION_AUTO=n

# Test-controlled kernel panic through /proc/sysrq-trigger; no serial input path.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=n
