+        bool valid = *digit != '\0';
+        for (; *digit != '\0'; ++digit) {
+            if (*digit < '0' || *digit > '9' || number > (INT_MAX - 9) / 10) {
+                valid = false;
+                break;
+            }
+            number = number * 10 + (*digit - '0');
