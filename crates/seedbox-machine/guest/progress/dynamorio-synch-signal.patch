Upstream DynamoRIO i#7748 (commit 985af57d7c, "Fix signal stack overflow
during thread synch"), applied unchanged to release 11.3.0-1.

While one thread synchs with another it may send a second suspend signal
before the first suspend handler has returned, because the handler
notifies the synching thread before it exits. The suspend signal is
unblocked inside the handler, so on a busy or single-CPU machine the
handlers nest until the signal stack overflows and the kernel kills the
process with SIGSEGV. Block the suspend signal before notifying.
diff --git a/core/unix/signal.c b/core/unix/signal.c
index d3fb14a1ef..dd05adc5ff 100644
--- a/core/unix/signal.c
+++ b/core/unix/signal.c
@@ -8837,7 +8837,17 @@ handle_suspend_signal(dcontext_t *dcontext, kernel_siginfo_t *siginfo,
 
     if (unblocked_sigs) {
         /* re-block so our exit from main_signal_handler is not interrupted */
+        kernel_sigaddset(&prevmask, SUSPEND_SIGNAL);
         sigprocmask_syscall(SIG_SETMASK, &prevmask, NULL, sizeof(prevmask));
+    } else {
+        /* Prevent another SUSPEND_SIGNAL interrupting main_signal_handler before we
+         * exit.
+         */
+        kernel_sigset_t mask;
+        kernel_sigemptyset(&mask);
+        kernel_sigaddset(&mask, SUSPEND_SIGNAL);
+
+        sigprocmask_syscall(SIG_BLOCK, &mask, NULL, sizeof(mask));
     }
     ostd->suspended_sigcxt = NULL;
 
