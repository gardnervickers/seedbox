     g_assert_nonnull(err);
     error_free(err);
 }
+static void delivery_frames(void)
+{
+    uint8_t h[32], value[32];
+    const struct { uint8_t kind; uint64_t a, b; const char *hex; } v[] = {
+        { 'J', 1, 0, "fe97db2f78e759c8620b6c5a1387b55496ec625469582822e40ea8d3c0b2bf31" },
+        { 'J', 2, 0, "fde5621fa9c29a6f59401df00f07b99f01f13519644ead788571df2936df6a14" },
+        { 'J', 3, 0x7a, "a1e2123708f463f39b59e1b6e1e833faba4258bccd3388581c67f94bcfd19908" },
+        { 'G', 1, 0, "db3d671534c4512ab6266a14732869d7b9d352251e8289255e795efc7b33731d" },
+        { 'G', 2, 0, "9e02f171353fca073065a378c49ef1704a1926e1cee77d481d938dbdeeb03095" },
+    };
+    g_assert_true(seedbox_witness_initial(h, &error_abort));
+    for (unsigned i = 0; i < G_N_ELEMENTS(v); i++) {
+        g_assert_true(seedbox_witness_record_hash(h, v[i].kind, 0, 123,
+                                                 v[i].a, v[i].b, value, &error_abort));
+        equal_hex(value, v[i].hex);
+    }
+    bool seen = false;
+    g_assert_false(seedbox_witness_accept_reset(&seen, 0));
+    g_assert_false(seedbox_witness_accept_reset(&seen, 3));
+    g_assert_false(seen);
+    g_assert_true(seedbox_witness_accept_reset(&seen, 1));
+    g_assert_true(seen);
+    g_assert_false(seedbox_witness_accept_reset(&seen, 1));
+    g_assert_false(seedbox_witness_accept_reset(&seen, 2));
+    /* Restored latch: do not append a second request for the same physical boot. */
+    bool restored = seen;
+    g_assert_false(seedbox_witness_accept_reset(&restored, 1));
+    g_assert_false(seedbox_witness_accept_reset(&restored, 2));
+    seen = false;
+    g_assert_true(seedbox_witness_accept_reset(&seen, 2));
+}
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
     g_test_add_func("/seedbox/witness/common-goldens", goldens);
+    g_test_add_func("/seedbox/witness/delivery-frames-and-reset-latch", delivery_frames);
     return g_test_run();
 }
