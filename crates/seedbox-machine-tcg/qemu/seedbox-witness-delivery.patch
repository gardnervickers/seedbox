diff --git a/target/i386/seedbox-witness-delivery.h b/target/i386/seedbox-witness-delivery.h
new file mode 100644
index 00000000..ebc7ab98
--- /dev/null
+++ b/target/i386/seedbox-witness-delivery.h
@@ -0,0 +1,9 @@
+/* Private x86 witness source mapping. Stable categories, not QEMU enum bits. */
+#ifndef SEEDBOX_WITNESS_DELIVERY_H
+#define SEEDBOX_WITNESS_DELIVERY_H
+#include "qemu/osdep.h"
+/* G: 1=accepted CPU shutdown/triple fault, 2=ACPI GED reset write.
+ * A production physical boot stops after its first accepted reset request.
+ * The latch migrates; invalid source codes and duplicates change nothing. */
+bool seedbox_witness_accept_reset(bool *seen, uint8_t cause);
+#endif
diff --git a/target/i386/seedbox-witness-delivery.c b/target/i386/seedbox-witness-delivery.c
new file mode 100644
index 00000000..1f08bc31
--- /dev/null
+++ b/target/i386/seedbox-witness-delivery.c
@@ -0,0 +1,11 @@
+#include "qemu/osdep.h"
+#include "seedbox-witness-delivery.h"
+
+bool seedbox_witness_accept_reset(bool *seen, uint8_t cause)
+{
+    if (*seen || (cause != 1 && cause != 2)) {
+        return false;
+    }
+    *seen = true;
+    return true;
+}
