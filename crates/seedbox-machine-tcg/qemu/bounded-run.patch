+/* Deterministic stopped ingress for Seedbox's machine lifecycle port. */
+#include "qemu/osdep.h"
+#include "exec/icount.h"
+#include "hw/virtio/virtio-serial.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-run-state.h"
+#include "qapi/qapi-commands-net.h"
+#include "qemu/bswap.h"
+#include "system/runstate.h"
+#include "qemu/module.h"
+#include "system/cpus.h"
+#include "hw/core/cpu.h"
+
+#define TYPE_SEEDBOX_LIFECYCLE "seedbox-lifecycle-port"
+OBJECT_DECLARE_SIMPLE_TYPE(SeedboxLifecycle, SEEDBOX_LIFECYCLE)
+
+struct SeedboxLifecycle {
+    VirtIOSerialPort parent_obj;
+    bool requested;
+    uint32_t input_size;
+    uint32_t cursor;
+    uint8_t *input;
+    uint32_t output_size;
+    uint8_t *output;
+};
+
+/* The reference machine has exactly one lifecycle port. No socket, host I/O
+ * callback or timer may introduce input between accepted execution barriers. */
+static SeedboxLifecycle *lifecycle;
+static const uint8_t request[] = "shutdown\n";
+
+/* QEMU classifies every CPU as idle while the VM is stopped. Ask instead
+ * whether a halted CPU now has deliverable work, such as the interrupt that
+ * drain_input raises synchronously, so the stopped guest is not reported blocked. */
+static bool cpus_runnable(void)
+{
+    CPUState *cpu;
+    CPU_FOREACH(cpu) {
+        if (!cpu_work_list_empty(cpu) || !cpu->halted || cpu_has_work(cpu)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void drain_input(VirtIOSerialPort *port)
+{
+    SeedboxLifecycle *s = SEEDBOX_LIFECYCLE(port);
+    size_t length = s->input_size;
+    if (s->cursor < length) {
+        ssize_t written = virtio_serial_write(port, s->input + s->cursor,
+                                              length - s->cursor);
+        /* Zero/negative writes leave input pending; partial writes retain the
+         * exact suffix. Never wrap a signed return into the migrated cursor. */
+        if (written > 0) {
+            g_assert(written <= length - s->cursor);
+            s->cursor += written;
+        }
+    }
+}
+
+/* Migration callbacks must never deliver retained input during restore. */
+static void drain_request(VirtIOSerialPort *port)
+{
+    if (runstate_is_running()) {
+        drain_input(port);
+    }
+}
+
+static void append_input(const uint8_t *bytes, size_t length)
+{
+    SeedboxLifecycle *s = lifecycle;
+    uint32_t pending = s->input_size - s->cursor;
+    g_assert((uint64_t)pending + length <= UINT32_MAX);
+    if (pending) {
+        memmove(s->input, s->input + s->cursor, pending);
+    }
+    s->input_size = pending + length;
+    s->cursor = 0;
+    s->input = g_realloc(s->input, s->input_size);
+    memcpy(s->input + pending, bytes, length);
+}
+
+SeedboxShutdownResult *qmp_seedbox_input_lifecycle(uint8List *bytes,
+                                                Error **errp)
+{
+    SeedboxShutdownResult *result;
+    GByteArray *input;
+    if (runstate_is_running() || !lifecycle) {
+        error_setg(errp, "lifecycle input requires a stopped port");
+        return NULL;
+    }
+    input = g_byte_array_new();
+    for (uint8List *item = bytes; item; item = item->next) {
+        g_byte_array_append(input, &item->value, 1);
+    }
+    if (input->len) {
+        append_input(input->data, input->len);
+        drain_input(VIRTIO_SERIAL_PORT(lifecycle));
+    }
+    g_byte_array_unref(input);
+    result = g_new0(SeedboxShutdownResult, 1);
+    result->runnable = cpus_runnable();
+    return result;
+}
+
+static bool request_shutdown(void)
+{
+    if (!lifecycle->requested) {
+        lifecycle->requested = true;
+        append_input(request, sizeof(request) - 1);
+    }
+    drain_input(VIRTIO_SERIAL_PORT(lifecycle));
+    return cpus_runnable();
+}
+
+static void guest_connected(VirtIOSerialPort *port, int connected)
+{
+    if (connected) {
+        drain_request(port);
+    }
+}
+
+/* One stream, in synchronous device observation order. No host callbacks
+ * reconstruct ordering or time after the CPU has stopped. */
+static void retain_output(uint8_t kind, const uint8_t *buf, uint32_t length)
+{
+    SeedboxLifecycle *s = lifecycle;
+    g_assert((uint64_t)s->output_size + 13 + (uint64_t)length <= UINT32_MAX);
+    uint32_t at = s->output_size;
+    s->output_size += 13 + length;
+    s->output = g_realloc(s->output, s->output_size);
+    s->output[at] = kind;
+    stq_le_p(s->output + at + 1, icount_get());
+    stl_le_p(s->output + at + 9, length);
+    memcpy(s->output + at + 13, buf, length);
+}
+
+static void retain_console(uint8_t byte)
+{
+    retain_output(SEEDBOX_OUTPUT_KIND_CONSOLE, &byte, 1);
+}
+
+static ssize_t retain_reply(VirtIOSerialPort *port, const uint8_t *buf,
+                            ssize_t length)
+{
+    if (length > 0) {
+        g_assert((uint64_t)length <= UINT32_MAX);
+        retain_output(SEEDBOX_OUTPUT_KIND_LIFECYCLE, buf, length);
+    }
+    return length;
+}
+
+SeedboxLifecycleWriteList *qmp_seedbox_drain_lifecycle(Error **errp)
+{
+    SeedboxLifecycleWriteList *result = NULL, **tail = &result;
+    if (runstate_is_running() || !lifecycle) {
+        error_setg(errp, "lifecycle drain requires a stopped port");
+        return NULL;
+    }
+    for (uint32_t at = 0; at < lifecycle->output_size;) {
+        SeedboxLifecycleWrite *write = g_new0(SeedboxLifecycleWrite, 1);
+        uint8List **bytes = &write->bytes;
+        uint32_t length = ldl_le_p(lifecycle->output + at + 9);
+        write->kind = lifecycle->output[at];
+        write->time = ldq_le_p(lifecycle->output + at + 1);
+        for (uint32_t i = 0; i < length; i++) {
+            *bytes = g_new0(uint8List, 1);
+            (*bytes)->value = lifecycle->output[at + 13 + i];
+            bytes = &(*bytes)->next;
+        }
+        *tail = g_new0(SeedboxLifecycleWriteList, 1);
+        (*tail)->value = write;
+        tail = &(*tail)->next;
+        at += 13 + length;
+    }
+    g_clear_pointer(&lifecycle->output, g_free);
+    lifecycle->output_size = 0;
+    return result;
+}
+
+/* Count the entire journal, including every record's 13-byte framing. This
+ * bounds even empty writes before combining it with one bounded NIC chunk.
+ * Larger journals retain the existing separate-drain packet behavior. */
+#define INLINE_OUTPUT_LIMIT (64 * 1024)
+
+SeedboxRunDrain *qmp_seedbox_drain_run(bool network, Error **errp)
+{
+    SeedboxRunDrain *result = g_new0(SeedboxRunDrain, 1);
+    Error *local_err = NULL;
+
+    result->run = qmp_query_seedbox_run(&local_err);
+    if (local_err) {
+        goto fail;
+    }
+    if (!lifecycle) {
+        error_setg(&local_err, "run drain requires a stopped lifecycle port");
+        goto fail;
+    }
+    if (lifecycle->output_size <= INLINE_OUTPUT_LIMIT) {
+        result->has_writes = true;
+        result->writes = qmp_seedbox_drain_lifecycle(&local_err);
+        if (local_err) {
+            goto fail;
+        }
+    }
+    if (network) {
+        result->network = qmp_seedbox_net_drain(&local_err);
+        if (local_err) {
+            goto fail;
+        }
+    }
+    return result;
+
+fail:
+    error_propagate(errp, local_err);
+    qapi_free_SeedboxRunDrain(result);
+    return NULL;
+}
+
+static void lifecycle_realize(DeviceState *dev, Error **errp)
+{
+    if (lifecycle) {
+        error_setg(errp, "only one Seedbox lifecycle port is supported");
+        return;
+    }
+    lifecycle = SEEDBOX_LIFECYCLE(dev);
+    seedbox_icount_set_shutdown_handler(request_shutdown);
+    seedbox_icount_set_console_handler(retain_console);
+    virtio_serial_open(VIRTIO_SERIAL_PORT(dev));
+}
+
+static void lifecycle_unrealize(DeviceState *dev)
+{
+    g_clear_pointer(&lifecycle->output, g_free);
+    g_clear_pointer(&lifecycle->input, g_free);
+    lifecycle = NULL;
+    seedbox_icount_set_shutdown_handler(NULL);
+    seedbox_icount_set_console_handler(NULL);
+}
+
+static int lifecycle_post_load(void *opaque, int version)
+{
+    SeedboxLifecycle *s = opaque;
+    for (uint32_t at = 0; at < s->output_size;) {
+        if (s->output_size - at < 13 ||
+            s->output[at] > SEEDBOX_OUTPUT_KIND_LIFECYCLE) {
+            return -EINVAL;
+        }
+        uint32_t length = ldl_le_p(s->output + at + 9);
+        if (length > s->output_size - at - 13) {
+            return -EINVAL;
+        }
+        at += 13 + length;
+    }
+    /* Validation only: capture/restore must not deliver pending input. */
+    return s->cursor > s->input_size ? -EINVAL : 0;
+}
+
+static const VMStateDescription lifecycle_state = {
+    .name = TYPE_SEEDBOX_LIFECYCLE,
+    .version_id = 2,
+    .minimum_version_id = 2,
+    .post_load = lifecycle_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(requested, SeedboxLifecycle),
+        VMSTATE_UINT32(input_size, SeedboxLifecycle),
+        VMSTATE_UINT32(cursor, SeedboxLifecycle),
+        VMSTATE_VBUFFER_ALLOC_UINT32(input, SeedboxLifecycle, 1, NULL, input_size),
+        VMSTATE_UINT32(output_size, SeedboxLifecycle),
+        VMSTATE_VBUFFER_ALLOC_UINT32(output, SeedboxLifecycle, 1, NULL, output_size),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void lifecycle_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtIOSerialPortClass *pc = VIRTIO_SERIAL_PORT_CLASS(klass);
+    dc->vmsd = &lifecycle_state;
+    pc->realize = lifecycle_realize;
+    pc->unrealize = lifecycle_unrealize;
+    pc->guest_ready = drain_request;
+    pc->guest_writable = drain_request;
+    pc->set_guest_connected = guest_connected;
+    pc->have_data = retain_reply;
+}
+
+static const TypeInfo lifecycle_info = {
+    .name = TYPE_SEEDBOX_LIFECYCLE,
+    .parent = TYPE_VIRTIO_SERIAL_PORT,
+    .instance_size = sizeof(SeedboxLifecycle),
+    .class_init = lifecycle_class_init,
+};
+
+static void lifecycle_register_types(void)
+{
+    type_register_static(&lifecycle_info);
+}
