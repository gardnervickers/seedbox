+/* Called only at stopped boundaries under the BQL. */
+static void seedbox_state_changed(void *opaque, bool running, RunState state)
+{
+    if (!running) {
+        seedbox_active = false;
+        if (state == RUN_STATE_SHUTDOWN) {
+            switch (seedbox_shutdown_cause) {
+            case SHUTDOWN_CAUSE_GUEST_SHUTDOWN:
+                seedbox_reason = SEEDBOX_STOP_REASON_SHUTDOWN;
+                break;
+            case SHUTDOWN_CAUSE_GUEST_RESET:
+            case SHUTDOWN_CAUSE_GUEST_PANIC:
+                seedbox_reason = SEEDBOX_STOP_REASON_RESET;
+                break;
+            default:
+                /* Host-initiated or unexpected stops are not guest outcomes. */
+                seedbox_reason = SEEDBOX_STOP_REASON_ERROR;
+            }
+        } else if (state != RUN_STATE_PAUSED &&
+                   state != RUN_STATE_FINISH_MIGRATE &&
+                   state != RUN_STATE_POSTMIGRATE) {
+            seedbox_reason = SEEDBOX_STOP_REASON_ERROR;
+        }
+    }
+}
+
+/* Integer timestamps expose the ceiling of exact instruction completion time.
+ * An unfinished first charge keeps its remaining old-rate cost; subsequent
+ * instructions use factor. All fixed-point arithmetic uses 128 bits so a
+ * valid signed-nanosecond horizon never overflows intermediate products. */
+typedef struct SeedboxCost {
+    bool enabled;
+    int64_t count;
+    int64_t time;
+    uint32_t first;
+    uint32_t factor;
+} SeedboxCost;
+
+static SeedboxCost seedbox_cost;
+
+static const VMStateDescription vmstate_seedbox_cost = {
+    .name = "seedbox-execution-cost",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(enabled, SeedboxCost),
+        VMSTATE_INT64(count, SeedboxCost),
+        VMSTATE_INT64(time, SeedboxCost),
+        VMSTATE_UINT32(first, SeedboxCost),
+        VMSTATE_UINT32(factor, SeedboxCost),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static __int128 seedbox_completion(int64_t count)
+{
+    int64_t delta = count - qatomic_read(&seedbox_cost.count);
+    __int128 time = (__int128)qatomic_read(&seedbox_cost.time) * 1000;
+    uint32_t first = qatomic_read(&seedbox_cost.first);
+    uint32_t factor = qatomic_read(&seedbox_cost.factor);
+    if (delta > 0) {
+        time += (first ? first : factor) + (__int128)(delta - 1) * factor;
+    }
+    return time;
+}
+
+/* Whole default-rate charges are already integer nanoseconds. Keep the full
+ * fixed-point path for old partial work, other rates and checked overflow. */
+static int64_t seedbox_time(int64_t count)
+{
+    if (qatomic_read(&seedbox_cost.factor) == 1000 &&
+        qatomic_read(&seedbox_cost.first) == 0) {
+        int64_t time = qatomic_read(&seedbox_cost.time);
+        int64_t delta = count - qatomic_read(&seedbox_cost.count);
+        int64_t result;
+        if (!__builtin_add_overflow(time, MAX(delta, 0), &result)) {
+            return result;
+        }
+    }
+    return (seedbox_completion(count) + 999) / 1000;
+}
+
+/* Called stopped or by the CPU thread under the BQL. Advance only actual
+ * charged CPU time here. Idle/adopted time moves the anchor separately. */
+static void seedbox_reanchor(int64_t time)
+{
+    int64_t count = icount_get_raw();
+    int64_t delta = count - seedbox_cost.count;
+    __int128 credit;
+    uint32_t first = seedbox_cost.first;
+    uint32_t factor = seedbox_cost.factor;
+    uint32_t remaining;
+    if (delta == 0) {
+        credit = (__int128)(time - seedbox_cost.time) * 1000;
+        remaining = credit || first ? (first ? first : factor) - credit : 0;
+    } else {
+        credit = (__int128)time * 1000 - seedbox_completion(count);
+        remaining = credit ? factor - credit : 0;
+    }
+    g_assert(credit >= 0 && credit < (delta ? factor : (first ? first : factor)));
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set(&seedbox_cost.count, count);
+    qatomic_set(&seedbox_cost.time, time);
+    qatomic_set(&seedbox_cost.first, remaining);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+}
+
+static int64_t seedbox_count_until(int64_t time)
+{
+    if (seedbox_cost.factor == 1000 && seedbox_cost.first == 0) {
+        int64_t delta = MAX(time - seedbox_cost.time, 0);
+        int64_t result;
+        if (!__builtin_add_overflow(seedbox_cost.count, delta, &result)) {
+            return result;
+        }
+    }
+    __int128 available = (__int128)(time - seedbox_cost.time) * 1000;
+    uint32_t first = seedbox_cost.first ? seedbox_cost.first : seedbox_cost.factor;
+    if (available < first) {
+        return seedbox_cost.count;
+    }
+    return seedbox_cost.count + 1 + (available - first) / seedbox_cost.factor;
+}
+
+void qmp_seedbox_advance(int64_t time, Error **errp)
+{
+    int64_t now = icount_get();
+    if (runstate_is_running() || seedbox_active || time < now) {
+        error_setg(errp, "advance requires a stopped VM and monotonic time");
+        return;
+    }
+    if (seedbox_cost.enabled) {
+        seedbox_reanchor(now);
+        /* Withheld/idle time neither earns nor discards charged CPU work. */
+        seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                           &timers_state.vm_clock_lock);
+        qatomic_set(&seedbox_cost.time, time);
+        seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                             &timers_state.vm_clock_lock);
+    } else {
+        seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                           &timers_state.vm_clock_lock);
+        qatomic_set(&timers_state.qemu_icount_bias,
+                    timers_state.qemu_icount_bias + time - now);
+        seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                             &timers_state.vm_clock_lock);
+    }
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+}
+
+void qmp_seedbox_capture_complete(Error **errp)
+{
+    if (!runstate_check(RUN_STATE_POSTMIGRATE) || seedbox_active) {
+        error_setg(errp, "capture completion requires a stopped migration source");
+        return;
+    }
+    /* POSTMIGRATE cannot migrate again. PRELAUNCH is a legal stopped
+     * transition; do not start CPUs or service clock/timer/device work. */
+    runstate_set(RUN_STATE_PRELAUNCH);
+}
+
+void qmp_seedbox_run(int64_t time, int64_t budget, int64_t factor, Error **errp)
+{
+    int64_t now = icount_get();
+    int64_t count = icount_get_raw();
+
+    /* Single CPU keeps this first implementation's instruction/time mapping
+     * explicit. Multi-CPU scheduling is not part of the reference contract. */
+    if (icount_enabled() != ICOUNT_PRECISE ||
+        timers_state.icount_time_shift != 0 || icount_sleep ||
+        icount_align_option || replay_mode != REPLAY_MODE_NONE ||
+        !first_cpu || CPU_NEXT(first_cpu)) {
+        error_setg(errp, "seedbox-run needs one CPU and icount shift=0,align=off,sleep=off");
+        return;
+    }
+    if (runstate_is_running() || seedbox_active ||
+        runstate_check(RUN_STATE_SHUTDOWN)) {
+        error_setg(errp, "seedbox-run requires a stopped, non-exited machine");
+        return;
+    }
+    if (time < now || budget <= 0 || budget > INT64_MAX - time ||
+        budget > INT64_MAX - count || factor < 1000 || factor > 1000000) {
+        error_setg(errp, "invalid simulation time or instruction budget");
+        return;
+    }
+    if (!seedbox_controlled) {
+        qemu_add_vm_change_state_handler(seedbox_state_changed, NULL);
+        seedbox_shutdown_notifier.notify = seedbox_shutdown_notify;
+        qemu_register_shutdown_notifier(&seedbox_shutdown_notifier);
+        seedbox_controlled = true;
+    }
+    if (seedbox_cost.enabled) {
+        seedbox_reanchor(now);
+    }
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set(&seedbox_cost.count, count);
+    qatomic_set(&seedbox_cost.time, time);
+    qatomic_set(&seedbox_cost.factor, factor);
+    qatomic_set(&seedbox_cost.enabled, true);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    seedbox_end = time + budget;
+    seedbox_deadline = -1;
+    seedbox_reason = SEEDBOX_STOP_REASON_ERROR;
+    seedbox_active = true;
+    vm_start();
+    /* Service events due at the supplied wake time before classifying idle. */
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+}
+
+SeedboxRunResult *qmp_query_seedbox_run(Error **errp)
+{
+    SeedboxRunResult *result;
+    if (runstate_is_running() || seedbox_active) {
+        error_setg(errp, "seedbox result requires a completed stop");
+        return NULL;
+    }
+    result = g_new0(SeedboxRunResult, 1);
+    result->reason = seedbox_reason;
+    result->time = icount_get();
+    result->has_deadline = seedbox_reason == SEEDBOX_STOP_REASON_BLOCKED &&
+                           seedbox_deadline >= 0;
+    result->deadline = seedbox_deadline;
+    return result;
+}
+
+/* Called by the single TCG CPU thread while preparing a translated-block
+ * budget. icount already splits a block exactly at this instruction limit. */
+int64_t seedbox_icount_limit(int64_t limit)
+{
+    if (seedbox_active) {
+        int64_t now = icount_get();
+        int64_t end = now + MIN(limit, seedbox_end - now);
+        return MAX(0, seedbox_count_until(end) - icount_get_raw());
+    }
+    return icount_round(limit);
+}
+
+/* Called under the BQL between CPU executions, never from a translated block.
+ * Stop before the idle loop can wait or the main loop can warp virtual time. */
+/* The idle thread must give the main loop a chance to service every due
+ * virtual timerlist rather than waiting for an IRQ a masked timer cannot
+ * provide. Called under BQL, before entering the idle condition wait. */
+bool seedbox_icount_pending_timer(void)
+{
+    return seedbox_active && runstate_is_running() &&
+        qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL, QEMU_TIMER_ATTR_ALL) == 0;
+}
+
+void seedbox_icount_poll(void)
+{
+    int64_t now, delay, horizon;
+    if (!seedbox_active || !runstate_is_running()) {
+        return;
+    }
+    /* A guest shutdown or reset stopped the CPU at its requesting
+     * instruction. Let the main loop classify that stop by its cause instead
+     * of reporting a boundary or idle stop first. */
+    if (qemu_shutdown_requested_get()) {
+        return;
+    }
+    now = icount_get();
+    if (now >= seedbox_end) {
+        seedbox_reanchor(now);
+        seedbox_reason = SEEDBOX_STOP_REASON_BOUNDARY;
+    } else if (all_cpu_threads_idle()) {
+        delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                           QEMU_TIMER_ATTR_ALL);
+        if (delay == 0) {
+            qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+            if (!all_cpu_threads_idle()) {
+                return;
+            }
+            delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                               QEMU_TIMER_ATTR_ALL);
+            if (delay == 0) {
+                qemu_notify_event();
+                return;
+            }
+        }
+        seedbox_reanchor(now);
+        seedbox_reason = SEEDBOX_STOP_REASON_BLOCKED;
+        seedbox_deadline = delay < 0 ? -1 : now + delay;
+    } else {
+        delay = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                           QEMU_TIMER_ATTR_ALL);
+        horizon = delay < 0 ? seedbox_end : now + MIN(delay, seedbox_end - now);
+        if (horizon > now && seedbox_count_until(horizon) == icount_get_raw()) {
+            /* Pay a partial instruction charge without executing its effects.
+             * This also handles a timer earlier than the next completion. */
+            seedbox_reanchor(horizon);
+            qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+            if (horizon == seedbox_end) {
+                seedbox_reason = SEEDBOX_STOP_REASON_BOUNDARY;
+            } else {
+                return;
+            }
+        } else {
+            return;
+        }
+    }
+    seedbox_active = false;
+    vm_stop(RUN_STATE_PAUSED);
+}
