+/*
+ * Private C ABI of Seedbox's Rust disk store. The normative contract is the
+ * rustdoc in Seedbox's crates/seedbox-machine/src/machine/disk/abi.rs.
+ * Durability policy stays in Rust: flushes happen only inside execute and
+ * nothing here discards unflushed data.
+ */
+#ifndef HW_BLOCK_SEEDBOX_DISK_H
+#define HW_BLOCK_SEEDBOX_DISK_H
+
+typedef struct SeedboxDisk SeedboxDisk;
+
+SeedboxDisk *seedbox_disk_open(uint64_t sectors, const uint8_t *image,
+                               size_t image_len);
+void seedbox_disk_close(SeedboxDisk *disk);
+uint64_t seedbox_disk_capacity(const SeedboxDisk *disk);
+bool seedbox_disk_execute(SeedboxDisk *disk,
+                          const struct iovec *out, size_t out_count,
+                          const struct iovec *in, size_t in_count,
+                          uint32_t *written, uint8_t *status);
+bool seedbox_disk_encode(const SeedboxDisk *disk, uint8_t **bytes,
+                         size_t *len);
+void seedbox_disk_bytes_free(uint8_t *bytes, size_t len);
+bool seedbox_disk_replace_overlays(SeedboxDisk *disk, const uint8_t *bytes,
+                                   size_t len);
+typedef size_t (*SeedboxRead)(void *context, uint8_t *buffer, size_t length);
+bool seedbox_disk_replace_overlays_from(SeedboxDisk *disk, uint64_t length,
+                                        SeedboxRead read, void *context);
+
+#endif
