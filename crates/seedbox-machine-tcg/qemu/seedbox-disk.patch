@@ -81,5 +81,9 @@ void seedbox_icount_set_shutdown_handler(bool (*handler)(void));
 
 void seedbox_icount_set_console_handler(void (*handler)(uint8_t));
 void seedbox_icount_console(uint8_t byte);
+/* A Seedbox device could not answer the guest. Sticky: the executing vCPU
+ * stops with an error result; a stopped (QMP) caller must fail its command.
+ * Every later seedbox-run is refused. Shared by all Seedbox devices. */
+void seedbox_icount_device_error(void);
 
