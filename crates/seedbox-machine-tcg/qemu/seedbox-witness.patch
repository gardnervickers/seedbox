--- a/hw/net/seedbox-net.c
+++ b/hw/net/seedbox-net.c
@@ -661,3 +661,36 @@ static void seedbox_net_register_types(void)
 }
 
 type_init(seedbox_net_register_types)
+
+/* FIFO order, retained guest frame bytes and retained TX timestamps only.
+ * No draining, DMA, model mutation or clock read. Delimiters and lengths make
+ * this canonical even for empty queues. Disk survival is observed separately.
+ */
+SeedboxNativePending *qmp_seedbox_net_pending(Error **errp)
+{
+    SeedboxFrame *frame;
+    GString *out = g_string_new("net-v1:");
+    if (!seedbox_net || runstate_is_running()) {
+        error_setg(errp, "seedbox net pending requires a stopped device");
+        g_string_free(out, true);
+        return NULL;
+    }
+    QSIMPLEQ_FOREACH(frame, &seedbox_net->backlog, next) {
+        g_string_append_printf(out, "%u:", frame->length);
+        for (unsigned i = 0; i < frame->length; i++) {
+            g_string_append_printf(out, "%02x", frame->bytes[i]);
+        }
+        g_string_append_c(out, ':');
+    }
+    g_string_append_c(out, '|');
+    QSIMPLEQ_FOREACH(frame, &seedbox_net->outbox, next) {
+        g_string_append_printf(out, "%" PRId64 ":%u:", frame->time, frame->length);
+        for (unsigned i = 0; i < frame->length; i++) {
+            g_string_append_printf(out, "%02x", frame->bytes[i]);
+        }
+        g_string_append_c(out, ':');
+    }
+    SeedboxNativePending *result = g_new0(SeedboxNativePending, 1);
+    result->bytes = g_string_free(out, false);
+    return result;
+}
