diff --git a/target/i386/seedbox-witness-chain.c b/target/i386/seedbox-witness-chain.c
new file mode 100644
index 00000000..6408e5d0
--- /dev/null
+++ b/target/i386/seedbox-witness-chain.c
@@ -0,0 +1,75 @@
+/* Exactly the approved common Rust chain format. Compare within a backend,
+ * not with legacy streaming SHA state. Record62bytes => two SHA256 blocks;
+ * all record storage is stack32/62bytes, no allocation or unbounded history.
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qapi/error.h"
+#include "crypto/hash.h"
+#include "seedbox-witness-chain.h"
+
+static bool hashv(const struct iovec *iov, size_t count, uint8_t out[32],
+                  Error **errp)
+{
+    uint8_t *result = out;
+    size_t length = 32;
+    return qcrypto_hash_bytesv(QCRYPTO_HASH_ALGO_SHA256, iov, count,
+                               &result, &length, errp) == 0;
+}
+
+bool seedbox_witness_initial(uint8_t out[32], Error **errp)
+{
+    static const char domain[] = "seedbox-execution-witness-v1\0";
+    const struct iovec v = { .iov_base = (void *)domain,
+                            .iov_len = sizeof(domain) - 1 };
+    return hashv(&v, 1, out, errp);
+}
+
+bool seedbox_witness_record_hash(const uint8_t h[32], uint8_t kind, uint8_t size,
+                                 uint64_t time, uint64_t a, uint64_t b,
+                                 uint8_t out[32], Error **errp)
+{
+    uint8_t bytes[62];
+    const struct iovec v = { .iov_base = bytes, .iov_len = sizeof(bytes) };
+    memcpy(bytes, h, 32);
+    memcpy(bytes + 32, "rec\0", 4);
+    bytes[36] = kind;
+    bytes[37] = size;
+    stq_le_p(bytes + 38, time);
+    stq_le_p(bytes + 46, a);
+    stq_le_p(bytes + 54, b);
+    return hashv(&v, 1, out, errp);
+}
+
+bool seedbox_witness_read_hash(const uint8_t h[32], const uint8_t *pending,
+                               size_t length, uint8_t out[32], Error **errp)
+{
+    uint8_t size[8];
+    const struct iovec v[] = {
+        { .iov_base = (void *)h, .iov_len = 32 },
+        { .iov_base = (void *)"read\0", .iov_len = 5 },
+        { .iov_base = size, .iov_len = sizeof(size) },
+        { .iov_base = (void *)pending, .iov_len = length },
+    };
+    stq_le_p(size, length);
+    return hashv(v, G_N_ELEMENTS(v), out, errp);
+}
+
+bool seedbox_witness_boot_hash(const uint8_t old[32], uint8_t mark, uint64_t time,
+                               uint8_t out[32], Error **errp)
+{
+    uint8_t bytes[78];
+    const struct iovec v = { .iov_base = bytes, .iov_len = sizeof(bytes) };
+    if (mark < 1 || mark > 3) {
+        error_setg(errp, "seedbox execution witness: invalid successor mark");
+        return false;
+    }
+    if (!seedbox_witness_initial(bytes, errp)) {
+        return false;
+    }
+    memcpy(bytes + 32, "boot\0", 5);
+    memcpy(bytes + 37, old, 32);
+    bytes[69] = mark;
+    stq_le_p(bytes + 70, time);
+    return hashv(&v, 1, out, errp);
+}
