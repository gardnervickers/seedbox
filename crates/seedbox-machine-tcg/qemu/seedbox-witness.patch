diff --git a/target/i386/seedbox-witness.c b/target/i386/seedbox-witness.c
new file mode 100644
index 00000000..e95e2489
--- /dev/null
+++ b/target/i386/seedbox-witness.c
@@ -0,0 +1,114 @@
+/* Actual native interaction chain, independent of full-state/RAM diagnostics.
+ * Single vCPU. Guest I/O and synchronous completions run under the BQL.
+ * Query does not read a clock, run a timer, drain a device or hash RAM.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc-i386.h"
+#include "migration/vmstate.h"
+#include "system/runstate.h"
+#include "exec/icount.h"
+#include "seedbox-witness-chain.h"
+
+typedef struct SeedboxWitness {
+    bool configured;
+    bool failed;
+    uint8_t chain[32];
+} SeedboxWitness;
+static SeedboxWitness witness;
+
+static void native_record(uint8_t kind, uint8_t size, uint64_t a, uint64_t b)
+{
+    uint8_t next[32];
+    Error *error = NULL;
+    if (!witness.configured || witness.failed) {
+        return;
+    }
+    if (!seedbox_witness_record_hash(witness.chain, kind, size,
+                                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                     a, b, next, &error)) {
+        witness.failed = true;
+        error_report_err(error);
+        seedbox_icount_device_error();
+        return;
+    }
+    memcpy(witness.chain, next, sizeof(next));
+}
+
+static char *hex32(const uint8_t bytes[32])
+{
+    char *s = g_malloc(65);
+    for (unsigned i = 0; i < 32; i++) {
+        g_snprintf(s + 2 * i, 3, "%02x", bytes[i]);
+    }
+    return s;
+}
+
+/* Invoked by fresh physical construction ONLY. Incoming migration restores
+ * configured/chain without invoking this command. No native entropy record:
+ * qemu64 exposes neither RDRAND nor RDSEED; this board has no virtio-rng or
+ * fw_cfg RNG-seed provider. -seed initializes a host PRNG, not guest delivery.
+ */
+void qmp_seedbox_witness_start(const char *chain, uint64_t boot, bool forced,
+                             Error **errp)
+{
+    uint8_t initial[32];
+    if (runstate_is_running() || witness.configured || strlen(chain) != 64) {
+        error_setg(errp, "seedbox witness start needs an unconfigured stopped physical boot");
+        return;
+    }
+    for (unsigned i = 0; i < 32; i++) {
+        int hi = g_ascii_xdigit_value(chain[2 * i]);
+        int lo = g_ascii_xdigit_value(chain[2 * i + 1]);
+        if (hi < 0 || lo < 0 || g_ascii_isupper(chain[2 * i]) ||
+            g_ascii_isupper(chain[2 * i + 1])) {
+            error_setg(errp, "seedbox witness chain must be lowercase SHA256");
+            return;
+        }
+        initial[i] = (hi << 4) | lo;
+    }
+    memcpy(witness.chain, initial, sizeof(initial));
+    witness.configured = true;
+    if (forced) {
+        native_record('C', 0, 0, 0);
+    }
+    native_record('N', 0, boot, 0);
+    if (witness.failed) {
+        error_setg(errp, "seedbox witness initialization failed");
+    }
+}
+
+SeedboxNativeChain *qmp_seedbox_witness_chain(Error **errp)
+{
+    if (runstate_is_running() || !witness.configured || witness.failed) {
+        error_setg(errp, "seedbox witness query needs a healthy configured stopped machine");
+        return NULL;
+    }
+    /* No owed CPU I/O: all guest PIO/MMIO completes synchronously before
+     * stopping. Device and Rust frontend pending state is observed separately.
+     * Return h, not observe(h, empty): the frontend appends canonical pending.
+     */
+    SeedboxNativeChain *result = g_new0(SeedboxNativeChain, 1);
+    result->chain = hex32(witness.chain);
+    return result;
+}
+
+static const VMStateDescription vmstate_witness = {
+    .name = "seedbox-native-witness",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(configured, SeedboxWitness),
+        VMSTATE_BOOL(failed, SeedboxWitness),
+        VMSTATE_UINT8_ARRAY(chain, SeedboxWitness, 32),
+        VMSTATE_END_OF_LIST()
+    }
+};
+static void register_witness(void)
+{
+    vmstate_register(NULL, 0, &vmstate_witness, &witness);
+    seedbox_native_set_sink(native_record);
+}
+type_init(register_witness)
