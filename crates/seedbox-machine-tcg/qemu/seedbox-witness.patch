+    }
+    g_string_append_printf(out, "%u:", lifecycle->requested);
+    g_string_append_printf(out, "%u:", lifecycle->input_size - lifecycle->cursor);
+    for (uint32_t i = lifecycle->cursor; i < lifecycle->input_size; i++) {
+        g_string_append_printf(out, "%02x", lifecycle->input[i]);
+    }
+    g_string_append_printf(out, ":%u:", lifecycle->output_size);
+    for (uint32_t i = 0; i < lifecycle->output_size; i++) {
+        g_string_append_printf(out, "%02x", lifecycle->output[i]);
+    }
+    SeedboxNativePending *result = g_new0(SeedboxNativePending, 1);
+    result->bytes = g_string_free(out, false);
+    return result;
+}
