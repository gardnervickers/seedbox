diff --git a/tests/unit/test-seedbox-witness-chain.c b/tests/unit/test-seedbox-witness-chain.c
new file mode 100644
index 00000000..b4c977f6
--- /dev/null
+++ b/tests/unit/test-seedbox-witness-chain.c
@@ -0,0 +1,54 @@
+/* Host-only production SHA helper tests. Never constructs a CPU or guest. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "target/i386/seedbox-witness-chain.h"
+
+static void equal_hex(const uint8_t value[32], const char *expected)
+{
+    for (unsigned i = 0; i < 32; i++) {
+        g_assert_cmpint(value[i] >> 4, ==, g_ascii_xdigit_value(expected[2*i]));
+        g_assert_cmpint(value[i] & 15, ==, g_ascii_xdigit_value(expected[2*i+1]));
+    }
+}
+static void goldens(void)
+{
+    uint8_t h[32], record[32], read[32], next[32], again[32];
+    const uint8_t pending[] = { 0, 1, 255 };
+    g_assert_true(seedbox_witness_initial(h, &error_abort));
+    equal_hex(h, "c2e5a8555ad36cf11fe81749aaac6c14897cefbeaeaaac525a6628add49d99b0");
+    g_assert_true(seedbox_witness_record_hash(h, 'w', 4, 123, 0x0b010020,
+                                             0x11223344, record, &error_abort));
+    equal_hex(record, "e45af213d61d286d545a619fd321c2a22bc57baa603596864aadde9f113abffd");
+    g_assert_true(seedbox_witness_read_hash(record, pending, 3, read, &error_abort));
+    equal_hex(read, "9593674b03604b7e2a8460597c2d5086d4bbf57784c603ce9116abf6b9ada009");
+    g_assert_true(seedbox_witness_boot_hash(read, 1, 456, next, &error_abort));
+    equal_hex(next, "93b23986012485c3ef98ff3f88c544342bf13f474368300d0d4d181cf60cd5f0");
+    /* Reading is idempotent and leaves the persisted chain untouched. */
+    g_assert_true(seedbox_witness_read_hash(record, pending, 3, again, &error_abort));
+    g_assert_cmpmem(read, 32, again, 32);
+    equal_hex(record, "e45af213d61d286d545a619fd321c2a22bc57baa603596864aadde9f113abffd");
+    /* A copied persisted 32-byte chain continues identically. */
+    memcpy(again, record, 32);
+    g_assert_true(seedbox_witness_record_hash(record, 'H', 0, 200, 0, 0, next, &error_abort));
+    g_assert_true(seedbox_witness_record_hash(again, 'H', 0, 200, 0, 0, again, &error_abort));
+    g_assert_cmpmem(next, 32, again, 32);
+    /* Every record field participates; do not accidentally hash a struct. */
+    const uint8_t kinds[] = { 'r','w','w','w','w' };
+    const uint8_t sizes[] = { 4,8,4,4,4 };
+    for (unsigned i = 0; i < 5; i++) {
+        g_assert_true(seedbox_witness_record_hash(h, kinds[i], sizes[i],
+            123 + (i == 2), 0x0b010020 + (i == 3),
+            0x11223344 + (i == 4), next, &error_abort));
+        g_assert_cmpint(memcmp(record, next, 32), !=, 0);
+    }
+    Error *err = NULL;
+    g_assert_false(seedbox_witness_boot_hash(read, 0, 456, next, &err));
+    g_assert_nonnull(err);
+    error_free(err);
+}
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/seedbox/witness/common-goldens", goldens);
+    return g_test_run();
+}
