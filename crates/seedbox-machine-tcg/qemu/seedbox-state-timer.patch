+/* Portable production page-writer tests. No QEMU process or guest. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "target/i386/seedbox-evidence-pages.h"
+
+static int new_file(char **path)
+{
+    GError *error = NULL;
+    int fd = g_file_open_tmp("seedbox-pages-XXXXXX", path, &error);
+    g_assert_no_error(error);
+    g_assert_cmpint(fd, >=, 0);
+    return fd;
+}
+
+static void golden_and_partial(void)
+{
+    static const uint8_t expected[] = {
+        0xad, 0x7f, 0xac, 0xb2, 0x58, 0x6f, 0xc6, 0xe9,
+        0xc9, 0xac, 0x7b, 0x06, 0x24, 0x82, 0x4f, 0x84,
+        0x0a, 0x88, 0x11, 0x18, 0x52, 0x09, 0x5c, 0xae
+    };
+    uint8_t ram[4096 * 2 + 17] = { 0 }, actual[sizeof(expected)];
+    g_autofree char *path = NULL;
+    uint64_t written = 0;
+    int fd = new_file(&path);
+    memset(ram + 4096, 7, 4096);
+    g_assert_true(seedbox_evidence_pages(fd, ram, sizeof(ram), &written,
+                                        &error_abort));
+    g_assert_cmpuint(written, ==, sizeof(expected));
+    g_assert_cmpint(lseek(fd, 0, SEEK_SET), ==, 0);
+    g_assert_cmpint(read(fd, actual, sizeof(actual)), ==, sizeof(actual));
+    g_assert_cmpmem(actual, sizeof(actual), expected, sizeof(expected));
+    g_assert_cmpint(close(fd), ==, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+}
+
+static void regions_are_not_joined_or_padded(void)
+{
+    static const uint8_t expected[] = {
+        0x0a, 0x88, 0x11, 0x18, 0x52, 0x09, 0x5c, 0xae,
+        0x75, 0xc8, 0xfd, 0x04, 0xad, 0x91, 0x6a, 0xec
+    };
+    uint8_t first[17] = { 0 }, second[3] = { 1, 1, 1 }, actual[16];
+    g_autofree char *path = NULL;
+    uint64_t written = 0;
+    int fd = new_file(&path);
+    g_assert_true(seedbox_evidence_pages(fd, first, sizeof(first), &written,
+                                        &error_abort));
+    g_assert_true(seedbox_evidence_pages(fd, second, sizeof(second), &written,
+                                        &error_abort));
+    g_assert_cmpuint(written, ==, sizeof(expected));
+    g_assert_cmpint(lseek(fd, 0, SEEK_SET), ==, 0);
+    g_assert_cmpint(read(fd, actual, sizeof(actual)), ==, sizeof(actual));
+    g_assert_cmpmem(actual, sizeof(actual), expected, sizeof(expected));
+    g_assert_cmpint(close(fd), ==, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+}
+
+static void io_and_count_errors(void)
+{
+    uint8_t ram[17] = { 0 };
+    uint64_t written = 0;
+    Error *error = NULL;
+    g_autofree char *path = NULL;
+    int fd = new_file(&path);
+    g_assert_false(seedbox_evidence_pages(-1, ram, sizeof(ram), &written, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_cmpuint(written, ==, 0);
+    written = UINT64_MAX - 1;
+    g_assert_false(seedbox_evidence_pages(fd, ram, sizeof(ram), &written, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_cmpuint(written, ==, UINT64_MAX - 1);
+    g_assert_cmpint(lseek(fd, 0, SEEK_END), ==, 0);
+    g_assert_cmpint(close(fd), ==, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/seedbox/pages/golden-partial", golden_and_partial);
+    g_test_add_func("/seedbox/pages/region-boundaries", regions_are_not_joined_or_padded);
+    g_test_add_func("/seedbox/pages/errors", io_and_count_errors);
+    return g_test_run();
+}
