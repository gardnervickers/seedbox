+++ b/target/i386/seedbox-policy.c
@@ -0,0 +1,121 @@
+/* Dedicated stopped-configured timer randomness, independent of guest entropy. */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/bswap.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc-i386.h"
+#include "crypto/hash.h"
+#include "migration/vmstate.h"
+#include "system/runstate.h"
+#include "exec/icount.h"
+#include "seedbox-policy.h"
+#include "seedbox-timer-rng.h"
+
+#define HOUR_NS UINT64_C(3600000000000)
+
+typedef struct SeedboxTimerPolicy {
+    bool configured;
+    uint64_t jitter;
+    uint8_t key[32];
+    uint64_t counter;
+} SeedboxTimerPolicy;
+
+static SeedboxTimerPolicy policy;
+/* External factory authority, not overwritten by incoming migration. */
+static SeedboxTimerPolicy expected;
+
+static int policy_loaded(void *opaque, int version)
+{
+    SeedboxTimerPolicy *saved = opaque;
+    if (saved->configured != expected.configured ||
+        saved->jitter != expected.jitter ||
+        memcmp(saved->key, expected.key, sizeof(saved->key))) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_seedbox_policy = {
+    .name = "seedbox-timer-policy",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = policy_loaded,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(configured, SeedboxTimerPolicy),
+        VMSTATE_UINT64(jitter, SeedboxTimerPolicy),
+        VMSTATE_UINT8_ARRAY(key, SeedboxTimerPolicy, 32),
+        VMSTATE_UINT64(counter, SeedboxTimerPolicy),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+/* Called only for fresh guest-device arms, never timer-load or post-load. */
+static int64_t transform(int64_t deadline)
+{
+    Error *error = NULL;
+    int64_t effective;
+    if (!policy.configured) {
+        return deadline;
+    }
+    if (seedbox_timer_delay(policy.key, &policy.counter, policy.jitter,
+                           deadline, &effective, &error)) {
+        return effective;
+    }
+    error_report_err(error);
+    qemu_guest_timer_failed = true;
+    /* Latch the existing bounded-run device error as well as the runstate:
+     * no subsequent run can turn a timer failure into ordinary completion. */
+    seedbox_icount_device_error();
+    vm_stop(RUN_STATE_INTERNAL_ERROR);
+    return deadline;
+}
+
+void qmp_seedbox_timer_policy(uint64_t seed, const char *domain,
+                             uint64_t jitter, Error **errp)
+{
+    SeedboxTimerPolicy proposed = { .configured = true, .jitter = jitter };
+    if (qemu_guest_timer_failed) {
+        error_setg(errp, "seedbox timer policy cannot recover a failed timer");
+        return;
+    }
+    if (runstate_is_running() || jitter > HOUR_NS || !*domain) {
+        error_setg(errp, "seedbox timer policy requires a stopped machine, "
+                   "a nonempty domain and jitter no greater than one hour");
+        return;
+    }
+    if (!seedbox_timer_key(seed, domain, proposed.key, errp)) {
+        return;
+    }
+    if (expected.configured) {
+        if (expected.jitter != proposed.jitter ||
+            memcmp(expected.key, proposed.key, sizeof(proposed.key))) {
+            error_setg(errp, "seedbox timer policy is already configured differently");
+        }
+        return; /* An identical call must never reset the stream. */
+    }
+    expected = proposed;
+    policy = proposed;
+    qemu_guest_timer_transform = transform;
+}
+
+char *seedbox_timer_policy_digest(Error **errp)
+{
+    uint8_t fields[49];
+    char *out = NULL;
+    fields[0] = policy.configured;
+    stq_le_p(fields + 1, policy.jitter);
+    memcpy(fields + 9, policy.key, 32);
+    stq_le_p(fields + 41, policy.counter);
+    if (qcrypto_hash_digest(QCRYPTO_HASH_ALGO_SHA256, fields, sizeof(fields),
+                            &out, errp) < 0) {
+        return NULL;
+    }
+    return out;
+}
+
+static void register_policy(void)
+{
+    vmstate_register(NULL, 0, &vmstate_seedbox_policy, &policy);
+}
+type_init(register_policy)
