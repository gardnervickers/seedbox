@@ -0,0 +1,99 @@
+/* Portable tests of the actual production timer-stream helper. No VM. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "target/i386/seedbox-timer-rng.h"
+
+static void golden(void)
+{
+    static const int64_t expected[] = { 1552, 1466, 1610, 1008,
+                                        1462, 1615, 1343, 1097 };
+    uint8_t key[32];
+    uint64_t counter = 0;
+    int64_t effective;
+    unsigned i;
+    g_assert_true(seedbox_timer_key(42, "timer-jitter/node", key, &error_abort));
+    for (i = 0; i < G_N_ELEMENTS(expected); i++) {
+        g_assert_true(seedbox_timer_delay(key, &counter, 1000, 1000,
+                                         &effective, &error_abort));
+        g_assert_cmpint(effective, ==, expected[i]);
+    }
+    g_assert_cmpuint(counter, ==, G_N_ELEMENTS(expected));
+}
+
+static void zero_and_disarmed(void)
+{
+    uint8_t key[32] = { 0 };
+    uint64_t counter = 91;
+    int64_t effective;
+    g_assert_true(seedbox_timer_delay(key, &counter, 0, 123,
+                                     &effective, &error_abort));
+    g_assert_cmpint(effective, ==, 123);
+    g_assert_cmpuint(counter, ==, 91);
+    g_assert_true(seedbox_timer_delay(key, &counter, 100, -1,
+                                     &effective, &error_abort));
+    g_assert_cmpint(effective, ==, -1);
+    g_assert_cmpuint(counter, ==, 91);
+}
+
+static void domains_and_continuation(void)
+{
+    uint8_t a[32], b[32];
+    uint64_t counter = 0, restored;
+    int64_t effective, resumed;
+    unsigned i;
+    g_assert_true(seedbox_timer_key(42, "timer-jitter/node", a, &error_abort));
+    g_assert_true(seedbox_timer_key(42, "disk-loss/node/1", b, &error_abort));
+    g_assert_cmpint(memcmp(a, b, sizeof(a)), !=, 0);
+    for (i = 0; i < 17; i++) {
+        g_assert_true(seedbox_timer_delay(a, &counter, 1000, i,
+                                         &effective, &error_abort));
+    }
+    restored = counter;
+    for (i = 0; i < 100; i++) {
+        g_assert_true(seedbox_timer_delay(a, &counter, 1000, i,
+                                         &effective, &error_abort));
+        g_assert_true(seedbox_timer_delay(a, &restored, 1000, i,
+                                         &resumed, &error_abort));
+        g_assert_cmpint(effective, ==, resumed);
+        g_assert_cmpint(effective, >=, i);
+        g_assert_cmpint(effective, <=, i + 1000);
+    }
+    g_assert_cmpuint(counter, ==, restored);
+}
+
+static void errors(void)
+{
+    uint8_t key[32];
+    uint64_t counter = UINT64_MAX;
+    int64_t effective = 99;
+    Error *error = NULL;
+    g_assert_true(seedbox_timer_key(42, "timer-jitter/node", key, &error_abort));
+    g_assert_false(seedbox_timer_delay(key, &counter, 1000, 1, &effective, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_cmpint(effective, ==, 99);
+    counter = 0;
+    g_assert_false(seedbox_timer_delay(key, &counter, 1000, INT64_MAX - 100,
+                                      &effective, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_cmpint(effective, ==, 99);
+    counter = 0;
+    g_assert_false(seedbox_timer_delay(key, &counter, UINT64_C(3600000000001),
+                                      1, &effective, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_cmpuint(counter, ==, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/seedbox/timer/golden", golden);
+    g_test_add_func("/seedbox/timer/zero-disarmed", zero_and_disarmed);
+    g_test_add_func("/seedbox/timer/domains-continuation", domains_and_continuation);
+    g_test_add_func("/seedbox/timer/errors", errors);
+    return g_test_run();
+}
