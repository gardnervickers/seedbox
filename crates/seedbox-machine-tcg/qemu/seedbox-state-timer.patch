+#include "hw/intc/ioapic_internal.h"
+#include "seedbox-policy.h"
+#include "seedbox-evidence-pages.h"
+
+/* Explicit LE scalar projection, never C struct/padding or VMState bytes. */
+static void scalar(GByteArray *bytes, uint64_t value)
+{
+    uint8_t encoded[8];
+    stq_le_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static void segment(GByteArray *bytes, const SegmentCache *seg)
+{
+    scalar(bytes, seg->selector);
+    scalar(bytes, seg->base);
+    scalar(bytes, seg->limit);
+    scalar(bytes, seg->flags);
+}
+
+static char *part(GByteArray *bytes, Error **errp)
+{
+    char *digest = NULL;
+    if (qcrypto_hash_digest(QCRYPTO_HASH_ALGO_SHA256,
+                            bytes->data, bytes->len, &digest, errp) < 0) {
+        return NULL;
+    }
+    g_byte_array_set_size(bytes, 0);
+    return digest;
+}
+
+typedef struct SeedboxBoard {
+    PICCommonState *pic[2];
+    PITCommonState *pit;
+    MC146818RtcState *rtc;
+    IOAPICCommonState *ioapic;
+    bool duplicate;
+} SeedboxBoard;
+
+/* Fixed board types only; no guest access, device read, or generic inspector. */
+static int find_board(Object *obj, void *opaque)
+{
+    SeedboxBoard *board = opaque;
+    if (object_dynamic_cast(obj, TYPE_PIC_COMMON)) {
+        PICCommonState *pic = PIC_COMMON(obj);
+        unsigned index = !!pic->master;
+        board->duplicate |= board->pic[index] != NULL;
+        board->pic[index] = pic;
+    } else if (object_dynamic_cast(obj, TYPE_PIT_COMMON)) {
+        board->duplicate |= board->pit != NULL;
+        board->pit = PIT_COMMON(obj);
+    } else if (object_dynamic_cast(obj, TYPE_MC146818_RTC)) {
+        board->duplicate |= board->rtc != NULL;
+        board->rtc = MC146818_RTC(obj);
+    } else if (object_dynamic_cast(obj, TYPE_IOAPIC_COMMON)) {
+        board->duplicate |= board->ioapic != NULL;
+        board->ioapic = IOAPIC_COMMON(obj);
+    }
+    return 0;
+}
+
+static void timer_state(GByteArray *bytes, QEMUTimer *timer)
+{
+    scalar(bytes, timer != NULL);
+    scalar(bytes, timer ? timer_expire_time_ns(timer) : UINT64_MAX);
+}
+
+static bool board_state(GByteArray *bytes, X86CPU *cpu, Error **errp)
+{
+    SeedboxBoard board = { 0 };
+    APICCommonState *apic = cpu->apic_state;
+    unsigned i;
+    object_child_foreach_recursive(object_get_root(), find_board, &board);
+    if (board.duplicate) {
+        error_setg(errp, "seedbox evidence: ambiguous board timer/controller");
+        return false;
+    }
+    scalar(bytes, apic != NULL);
+    if (apic) {
+        scalar(bytes, apic->apicbase);
+        scalar(bytes, apic->id);
+        scalar(bytes, apic->tpr);
+        scalar(bytes, apic->spurious_vec);
+        scalar(bytes, apic->log_dest);
+        scalar(bytes, apic->dest_mode);
+        for (i = 0; i < ARRAY_SIZE(apic->isr); i++) {
+            scalar(bytes, apic->isr[i]);
+            scalar(bytes, apic->tmr[i]);
+            scalar(bytes, apic->irr[i]);
+        }
+        for (i = 0; i < ARRAY_SIZE(apic->lvt); i++) {
+            scalar(bytes, apic->lvt[i]);
+        }
+        scalar(bytes, apic->esr);
+        scalar(bytes, apic->icr[0]);
+        scalar(bytes, apic->icr[1]);
+        scalar(bytes, apic->divide_conf);
+        scalar(bytes, apic->count_shift);
+        scalar(bytes, apic->initial_count);
+        scalar(bytes, apic->initial_count_load_time);
+        scalar(bytes, apic->next_time);
+        scalar(bytes, apic->sipi_vector);
+        scalar(bytes, apic->wait_for_sipi);
+        timer_state(bytes, apic->timer);
+    }
+    for (i = 0; i < 2; i++) {
+        PICCommonState *pic = board.pic[i];
+        scalar(bytes, pic != NULL);
+        if (pic) {
+#define PIC_FIELD(name) scalar(bytes, pic->name)
+            PIC_FIELD(last_irr); PIC_FIELD(irr); PIC_FIELD(imr); PIC_FIELD(isr);
+            PIC_FIELD(priority_add); PIC_FIELD(irq_base); PIC_FIELD(read_reg_select);
+            PIC_FIELD(poll); PIC_FIELD(special_mask); PIC_FIELD(init_state);
+            PIC_FIELD(auto_eoi); PIC_FIELD(rotate_on_auto_eoi);
+            PIC_FIELD(special_fully_nested_mode); PIC_FIELD(init4);
+            PIC_FIELD(single_mode); PIC_FIELD(elcr); PIC_FIELD(elcr_mask);
+            PIC_FIELD(ltim);
+#undef PIC_FIELD
+        }
+    }
+    scalar(bytes, board.ioapic != NULL);
+    if (board.ioapic) {
+        scalar(bytes, board.ioapic->id);
+        scalar(bytes, board.ioapic->ioregsel);
+        scalar(bytes, board.ioapic->irr);
+        for (i = 0; i < IOAPIC_NUM_PINS; i++) {
+            scalar(bytes, board.ioapic->ioredtbl[i]);
+        }
+    }
+    scalar(bytes, board.pit != NULL);
+    if (board.pit) {
+        for (i = 0; i < 3; i++) {
+            PITChannelState *c = &board.pit->channels[i];
+#define PIT_FIELD(name) scalar(bytes, c->name)
+            PIT_FIELD(count); PIT_FIELD(latched_count); PIT_FIELD(count_latched);
+            PIT_FIELD(status_latched); PIT_FIELD(status); PIT_FIELD(read_state);
+            PIT_FIELD(write_state); PIT_FIELD(write_latch); PIT_FIELD(rw_mode);
+            PIT_FIELD(mode); PIT_FIELD(bcd); PIT_FIELD(gate);
+            PIT_FIELD(count_load_time); PIT_FIELD(next_transition_time);
+            PIT_FIELD(irq_disabled);
+#undef PIT_FIELD
+            timer_state(bytes, c->irq_timer);
+        }
+    }
+    scalar(bytes, board.rtc != NULL);
+    if (board.rtc) {
+        MC146818RtcState *rtc = board.rtc;
+        g_byte_array_append(bytes, rtc->cmos_data, sizeof(rtc->cmos_data));
+#define RTC_FIELD(name) scalar(bytes, rtc->name)
+        RTC_FIELD(cmos_index); RTC_FIELD(base_rtc); RTC_FIELD(last_update);
+        RTC_FIELD(offset); RTC_FIELD(next_periodic_time); RTC_FIELD(next_alarm_time);
+        RTC_FIELD(irq_coalesced); RTC_FIELD(period); RTC_FIELD(irq_reinject_on_ack_count);
+        scalar(bytes, qemu_guest_timer_transform ? rtc->seedbox_update_requested : 0);
+#undef RTC_FIELD
+        timer_state(bytes, rtc->periodic_timer);
+        timer_state(bytes, rtc->update_timer);
+        timer_state(bytes, rtc->coalesced_timer);
+    }
+    scalar(bytes, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    return true;
+}
+
+SeedboxX86Evidence *qmp_seedbox_x86_evidence(const char *page_file, Error **errp)
+{
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
+    g_autoptr(QCryptoHash) ram = NULL;
+    SeedboxX86Evidence *result = g_new0(SeedboxX86Evidence, 1);
+    SeedboxRamRegionList **tail = &result->regions;
+    CPUState *cs = first_cpu;
+    CPUX86State *env;
+    MachineState *machine = MACHINE(qdev_get_machine());
+    uint64_t address = 0;
+    int i, j, page_fd = -1;
+    bool page_created = false;
+
+    if (qemu_guest_timer_failed) {
+        error_setg(errp, "seedbox evidence after a failed timer");
+        goto fail;
+    }
+    if (runstate_is_running() || !cs || CPU_NEXT(cs) || !machine->ram) {
+        error_setg(errp, "seedbox evidence requires a stopped single-CPU RAM machine");
+        goto fail;
+    }
+    /* The caller owns this unique scratch path. Never overwrite an existing
+     * file or symlink, and remove only our own partial file on failure. Page
+     * bytes do not fit QMP's packet budget for large configured guests. */
+    page_fd = qemu_create(page_file, O_WRONLY | O_EXCL, 0600, errp);
+    if (page_fd < 0) {
+        goto fail;
+    }
+    page_created = true;
+    cpu_synchronize_state(cs);
+    env = &X86_CPU(cs)->env;
+    for (i = 0; i < CPU_NB_REGS; i++) {
+        scalar(bytes, env->regs[i]);
+    }
+    scalar(bytes, env->eip);
+    scalar(bytes, cpu_compute_eflags(env));
+    for (i = 0; i < ARRAY_SIZE(env->cr); i++) {
+        scalar(bytes, env->cr[i]);
+    }
+    for (i = 0; i < ARRAY_SIZE(env->dr); i++) {
+        scalar(bytes, env->dr[i]);
+    }
+    for (i = 0; i < ARRAY_SIZE(env->segs); i++) {
+        segment(bytes, &env->segs[i]);
+    }
+    segment(bytes, &env->ldt);
+    segment(bytes, &env->tr);
+    segment(bytes, &env->gdt);
+    segment(bytes, &env->idt);
+    result->regs = part(bytes, errp);
+    if (!result->regs) {
+        goto fail;
+    }
+    scalar(bytes, env->fpstt);
+    scalar(bytes, env->fpus);
+    scalar(bytes, env->fpuc);
+    scalar(bytes, env->fpop);
+    scalar(bytes, env->fpip);
+    scalar(bytes, env->fpdp);
+    for (i = 0; i < ARRAY_SIZE(env->fpregs); i++) {
+        scalar(bytes, env->fptags[i]);
+        scalar(bytes, env->fpregs[i].d.low);
+        scalar(bytes, env->fpregs[i].d.high);
+    }
+    scalar(bytes, env->mxcsr);
+    for (i = 0; i < CPU_NB_EREGS; i++) {
+        for (j = 0; j < 8; j++) {
+            scalar(bytes, env->xmm_regs[i].ZMM_Q(j));
+        }
+    }
+    for (i = 0; i < NB_OPMASK_REGS; i++) {
+        scalar(bytes, env->opmask_regs[i]);
+    }
+    result->vectors = part(bytes, errp);
+    if (!result->vectors) {
+        goto fail;
+    }
+    /* EXITTB, DEBUG, HALT, APIC polling and TPR reevaluation are host
+     * execution requests, not pending guest interrupts. Never hash them. */
+    scalar(bytes, cs->interrupt_request &
+           (CPU_INTERRUPT_HARD | CPU_INTERRUPT_NMI | CPU_INTERRUPT_SMI |
+            CPU_INTERRUPT_INIT | CPU_INTERRUPT_SIPI | CPU_INTERRUPT_MCE |
+            CPU_INTERRUPT_VIRQ));
+    /* halted is guest HLT eligibility, unlike CPUState.stopped/stop. */
+    scalar(bytes, cs->halted);
+    /* TCG uses exception_index >= EXCP_INTERRUPT for host rendezvous. */
+    scalar(bytes, cs->exception_index >= 0 && cs->exception_index < EXCP_INTERRUPT);
+    if (cs->exception_index >= 0 && cs->exception_index < EXCP_INTERRUPT) {
+        scalar(bytes, cs->exception_index);
+        scalar(bytes, env->error_code);
+        scalar(bytes, env->exception_is_int);
+        scalar(bytes, env->exception_next_eip);
+    }
+    scalar(bytes, env->hflags & HF_INHIBIT_IRQ_MASK);
+    scalar(bytes, env->hflags2 &
+           (HF2_GIF_MASK | HF2_HIF_MASK | HF2_NMI_MASK | HF2_VINTR_MASK |
+            HF2_SMM_INSIDE_NMI_MASK | HF2_NPT_MASK | HF2_VGIF_MASK));
+    result->events = part(bytes, errp);
+    if (!result->events) {
+        goto fail;
+    }
+    scalar(bytes, env->efer);
+    scalar(bytes, env->pat);
+    scalar(bytes, env->star);
+    scalar(bytes, env->sysenter_cs);
+    scalar(bytes, env->sysenter_esp);
+    scalar(bytes, env->sysenter_eip);
+    scalar(bytes, env->tsc_aux);
+    scalar(bytes, env->tsc_adjust);
+    scalar(bytes, env->tsc_deadline);
+    scalar(bytes, env->xcr0);
+#ifdef TARGET_X86_64
+    scalar(bytes, env->kernelgsbase);
+    scalar(bytes, env->lstar);
+    scalar(bytes, env->cstar);
+    scalar(bytes, env->fmask);
+#endif
+    result->msrs = part(bytes, errp);
+    if (!result->msrs) {
+        goto fail;
+    }
+    if (!board_state(bytes, X86_CPU(cs), errp)) {
+        goto fail;
+    }
+    result->timers = part(bytes, errp);
+    result->timer_policy = seedbox_timer_policy_digest(errp);
+    if (!result->timers || !result->timer_policy) {
+        goto fail;
+    }
+    ram = qcrypto_hash_new(QCRYPTO_HASH_ALGO_SHA256, errp);
+    if (!ram) {
+        goto fail;
+    }
+    while (address < UINT64_MAX) {
+            MemoryRegionSection section = memory_region_find(
+                get_system_memory(), address, UINT64_MAX - address);
+            uint64_t length, base;
+            uint8_t *data;
+            bool is_ram;
+            SeedboxRamRegionList *node;
+            if (!section.mr) {
+                break;
+            }
+            length = int128_get64(section.size);
+            base = section.offset_within_address_space;
+            is_ram = section.mr == machine->ram;
+            data = is_ram ? memory_region_get_ram_ptr(section.mr) +
+                            section.offset_within_region : NULL;
+            memory_region_unref(section.mr);
+            if (!length || base < address || length > UINT64_MAX - base) {
+                error_setg(errp, "seedbox evidence: invalid memory extent");
+                goto fail;
+            }
+            address = base + length;
+            if (!is_ram) {
+                continue;
+            }
+            if (base & 4095) {
+                error_setg(errp, "seedbox evidence: unaligned RAM region");
+                goto fail;
+            }
+            node = g_new0(SeedboxRamRegionList, 1);
+            node->value = g_new0(SeedboxRamRegion, 1);
+            node->value->base = base;
+            node->value->length = length;
+            *tail = node;
+            tail = &node->next;
+            if (qcrypto_hash_update(ram, data, length, errp) < 0) {
+                goto fail;
+            }
+            scalar(bytes, node->value->base);
+            scalar(bytes, length);
+            if (!seedbox_evidence_pages(page_fd, data, length,
+                                        &result->page_bytes, errp)) {
+                goto fail;
+            }
+    }
+    if (!result->regions) {
+        error_setg(errp, "seedbox evidence: no actual mapped machine RAM");
+        goto fail;
+    }
+    result->ram_regions = part(bytes, errp);
+    if (!result->ram_regions ||
+        qcrypto_hash_finalize_digest(ram, &result->ram, errp) < 0) {
+        goto fail;
+    }
+    if (close(page_fd) < 0) {
+        page_fd = -1;
+        error_setg_errno(errp, errno, "seedbox evidence page close");
+        goto fail;
+    }
+    page_fd = -1;
+    return result;
+fail:
+    if (page_fd >= 0) {
+        close(page_fd);
+    }
+    if (page_created) {
+        unlink(page_file);
+    }
+    qapi_free_SeedboxX86Evidence(result);
+    return NULL;
+}
