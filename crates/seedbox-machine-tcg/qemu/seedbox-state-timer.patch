+/* Exact legacy 4 KiB page records from actual stopped RAM bytes. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "crypto/hash.h"
+#include "seedbox-evidence-pages.h"
+
+bool seedbox_evidence_pages(int fd, const uint8_t *bytes, uint64_t length,
+                            uint64_t *written, Error **errp)
+{
+    uint64_t offset = 0;
+    while (offset < length) {
+        uint8_t digest[32], *out = digest;
+        size_t digest_length = sizeof(digest);
+        uint64_t chunk = MIN(4096, length - offset);
+        if (*written > UINT64_MAX - 8) {
+            error_setg(errp, "seedbox evidence page count overflow");
+            return false;
+        }
+        if (qcrypto_hash_bytes(QCRYPTO_HASH_ALGO_SHA256, bytes + offset,
+                               chunk, &out, &digest_length, errp) < 0) {
+            return false;
+        }
+        if (qemu_write_full(fd, digest, 8) != 8) {
+            error_setg_errno(errp, errno ? errno : EIO,
+                             "seedbox evidence page write");
+            return false;
+        }
+        *written += 8;
+        offset += chunk;
+    }
+    return true;
+}
