+/* Byte-for-byte seedbox-v1 SHA256 streams, not guest entropy. */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qapi/error.h"
+#include "crypto/hash.h"
+#include "seedbox-timer-rng.h"
+
+static bool digest(const uint8_t *data, size_t length, uint8_t output[32],
+                   Error **errp)
+{
+    size_t size = 32;
+    uint8_t *out = output;
+    return qcrypto_hash_bytes(QCRYPTO_HASH_ALGO_SHA256, data, length,
+                              &out, &size, errp) == 0;
+}
+
+bool seedbox_timer_key(uint64_t seed, const char *domain, uint8_t key[32],
+                       Error **errp)
+{
+    g_autoptr(GByteArray) input = g_byte_array_new();
+    uint8_t seed_bytes[8];
+    g_byte_array_append(input, (const uint8_t *)"seedbox-v1", 10);
+    stq_le_p(seed_bytes, seed);
+    g_byte_array_append(input, seed_bytes, sizeof(seed_bytes));
+    g_byte_array_append(input, (const uint8_t *)domain, strlen(domain));
+    return digest(input->data, input->len, key, errp);
+}
+
+bool seedbox_timer_delay(const uint8_t key[32], uint64_t *counter,
+                         uint64_t jitter, int64_t deadline,
+                         int64_t *effective, Error **errp)
+{
+    uint64_t n, zone, value;
+    uint8_t input[40], output[32];
+    if (!jitter || deadline < 0) {
+        *effective = deadline;
+        return true;
+    }
+    if (jitter > UINT64_C(3600000000000)) {
+        error_setg(errp, "seedbox timer jitter exceeds one hour");
+        return false;
+    }
+    n = jitter + 1;
+    zone = UINT64_MAX - UINT64_MAX % n;
+    memcpy(input, key, 32);
+    do {
+        if (*counter == UINT64_MAX) {
+            error_setg(errp, "seedbox timer RNG counter overflow");
+            return false;
+        }
+        stq_le_p(input + 32, (*counter)++);
+        if (!digest(input, sizeof(input), output, errp)) {
+            return false;
+        }
+        value = ldq_le_p(output);
+    } while (value >= zone);
+    value %= n;
+    if (value > INT64_MAX - deadline) {
+        error_setg(errp, "seedbox timer jitter deadline overflow");
+        return false;
+    }
+    *effective = deadline + value;
+    return true;
+}
