 /* modify the current timer so that it will be fired when current_time
    >= expire_time. The corresponding callback will be called. */
+int64_t (*qemu_guest_timer_transform)(int64_t deadline);
+bool qemu_guest_timer_failed;
+
+int64_t timer_mod_guest_ns(QEMUTimer *ts, int64_t expire_time)
+{
+    int64_t effective = qemu_guest_timer_transform ?
+        qemu_guest_timer_transform(expire_time) : expire_time;
+    timer_mod_ns(ts, effective);
+    return effective;
+}
+
 void timer_mod_ns(QEMUTimer *ts, int64_t expire_time)
 {
     QEMUTimerList *timer_list = ts->timer_list;
