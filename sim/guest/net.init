#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
idx=$(sed -n 's/.*seedbox.index=\([0-9]*\).*/\1/p' /proc/cmdline)
ip link set lo up
ip addr add 10.0.0.$((idx+1))/24 dev eth0
ip link set eth0 up
echo "net up: $(ip -o addr show eth0 | head -1)"
if [ "$idx" = 0 ]; then
  ping -c 5 10.0.0.2 && code=0 || code=1
  sbx exit $code
else
  while true; do sleep 10; done
fi
