#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /data
ip link set lo up
echo "seedbox: etcd single member, entropy $(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
/bin/etcd --name n1 --data-dir /data/n1 \
  --listen-client-urls http://127.0.0.1:2379 --advertise-client-urls http://127.0.0.1:2379 \
  --listen-peer-urls http://127.0.0.1:2380 --initial-advertise-peer-urls http://127.0.0.1:2380 \
  --initial-cluster n1=http://127.0.0.1:2380 --logger zap --log-level error > /tmp/etcd.log 2>&1 &
/bin/client --endpoints 127.0.0.1:2379 --duration 5s --concurrency 8
code=$?
echo "uptime $(cat /proc/uptime)"
[ $code -ne 0 ] && tail -20 /tmp/etcd.log
sbx exit $code
