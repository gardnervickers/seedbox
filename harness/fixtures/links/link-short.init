#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
idx=$(sed -n 's/.*seedbox.index=\([0-9]*\).*/\1/p' /proc/cmdline)
name=$(sed -n 's/.*seedbox.name=\([a-z0-9]*\).*/\1/p' /proc/cmdline)
ip link set lo up
ip addr add 10.0.0.$((idx+1))/24 brd 10.0.0.255 dev eth0
ip link set eth0 up
echo "link: $name up at index $idx"
gap=$(sed -n 's/.*seedbox.link_gap_ns=\([0-9]*\).*/\1/p' /proc/cmdline)
link-probe "$name" "${gap:-4000000}" 1100000000
[ "$name" = a ] && { sleep 0.1; sbx exit 0; }
while true; do sleep 10; done
